<?xml version="1.0" encoding="UTF-8"?>
<settings>

    <category label="Geral">
        <setting id="pages"
                 type="labelenum"
                 label="Itens por Página"
                 values="20|25|30|35|40|50|75|100|150"
                 default="25" />

        <setting id="view_mode"
                 type="labelenum"
                 label="Modo de Visualização Padrão"
                 values="list|poster|iconwall|shift|infowall|widelist|wall|banner|fanart"
                 default="wall" />

        <setting id="image_quality"
                 type="labelenum"
                 label="Qualidade das imagens"
                 values="low|medium|high|original"
                 default="high" />         
        
        <setting id="playback.autoplay" 
                 type="bool" 
                 label="Reprodução Automática" 
                 default="false">
            <description>Se ativado, tenta reproduzir a melhor fonte automaticamente.</description>
        </setting>               
    </category>

    <category label="Legendas">
    <setting id="enable_subtitles" type="bool" label="Ativar legendas automáticas" default="false"/>
    <setting id="subtitle_language" type="select" label="Idioma" values="por|pob|pt-br" default="por"/>
    <setting id="auto_load_subtitle" type="bool" label="Carregar automaticamente ao reproduzir" default="true" />
    </category>

    <category label="API">
        <setting id="tmdb_api"
                 type="text"
                 label="TMDB API Key"
                 default="">
            <description>Insira sua chave da API do TMDB para habilitar as funções de Tendências e Metadados externos.</description>
        </setting>

        <setting id="tmdb_language"
                 type="labelenum"
                 label="Idioma do Conteúdo (API)"
                 values="pt-BR|en-US|es-ES"
                 default="pt-BR" />
    </category>

    <category label="Extras">
       <setting id="movie.enable_details"
             type="bool"
             label="Filmes: usar tela de detalhes"
             default="true" />

    <!-- SÉRIES -->
    <setting id="tvshow.enable_details"
             type="bool"
             label="Séries: usar tela de detalhes"
             default="true" />
    </category>         

    <category label="Atualizações">
        <setting label="Verificar novo conteúdo" 
                 type="labelenum" 
                 id="update_interval" 
                 values="Desativado|A cada 3 horas|A cada 5 horas|A cada 12 horas|A cada 24 horas (Diariamente)" 
                 default="A cada 12 horas" />

        <setting label="[internal] Última data de verificação" 
                 type="text" 
                 id="last_update_check" 
                 visible="false" />
    </category>

    <category label="Biblioteca">
        <!-- DEIXE VAZIO para usar a pasta do addon automaticamente (compatível com Android/TV) -->
        <setting id="library.movies.path" 
                 type="folder" 
                 label="Pasta de Filmes" 
                 default="">
            <description>Deixe vazio para usar a pasta padrão do addon (recomendado para Android/TV)</description>
        </setting>
        
        <setting id="library.tvshows.path" 
                 type="folder" 
                 label="Pasta de Séries" 
                 default="">
            <description>Deixe vazio para usar a pasta padrão do addon (recomendado para Android/TV)</description>
        </setting>
        
        <setting id="library.auto_update" 
                 type="bool" 
                 label="Atualizar biblioteca automaticamente" 
                 default="true" />
        
        <setting id="library.update_interval" 
                 type="slider" 
                 label="Intervalo de atualização (horas)" 
                 default="24" 
                 range="1,1,72" 
                 option="int" 
                 enable="eq(-1,true)" />

        <setting id="sync_auto_library" 
                 type="bool" 
                 label="Sincronizar biblioteca automaticamente" default="true"/>         
    </category>

    <category label="Trakt.tv">
    <setting label="API" type="lsep"/> 
    <setting id="trakt_client_id" type="text" label="Client ID" default="2d29a7597164bb74e1d463bc4ebf8dc8b528f2beea715068de1744e88f80f764" />
    <setting id="trakt_client_secret" type="text" label="Client Secret" default="f71fa83d63e64a06a9cecf676a0f5e0485c4f2c1b5a48946d26c4630cef159fb" />
    <setting id="trakt_username" type="text" label="Usuário" default="" visible="false" />
    <setting id="trakt_access_token" type="text" label="Access Token" default="" visible="false" />
    <setting id="trakt_refresh_token" type="text" label="Refresh Token" default="" visible="false" />
    <setting id="trakt_expires_at" type="text" label="Expires At" default="0" visible="false" />

    <setting label="Sincronização" type="lsep"/> 
    <setting id="trakt_sync_on_startup" type="bool" label="Sincronizar no startup" default="true" />
    <setting id="trakt_sync_interval" type="enum" label="Intervalo de sincronização" values="15 minutos|30 minutos|60 minutos|120 minutos|240 minutos" default="60" />
    
    <setting id="trakt_sync_watched" type="bool" label="Sincronizar assistidos" default="true" />
    <setting id="trakt_sync_ratings" type="bool" label="Sincronizar avaliações" default="true" />
    <setting id="trakt_sync_collection" type="bool" label="Sincronizar coleção" default="true" />
    <setting id="trakt_sync_playback" type="bool" label="Sincronizar progresso" default="true" />

    <setting label="Autenticação" type="lsep"/> 
    <setting id="trakt_show_notifications" type="bool" label="Mostrar notificações Trakt" default="true"/>
    <setting type="action" label="Autenticar com Trakt" action="RunAddon(plugin.video.cineroom.lite,action=trakt_auth)" />
    <setting type="action" label="Sincronização Manual" action="RunAddon(plugin.video.cineroom.lite,action=trakt_sync)" />
    <setting type="action" label="Abrir Menu Trakt" action="RunAddon(plugin.video.cineroom.lite,action=trakt_menu)" />
    <setting id="trakt_auto_scrobble" type="bool" label="Scrobble Automático" default="true"/>
    <setting id="cache_age_hours" type="number" label="Cache (horas)" default="72"/>
    <setting label="Avaliação" type="lsep"/> 
    <setting 
        id="trakt_ask_rating_after_playback" 
        type="bool" 
        label="Perguntar avaliação após assistir"
        default="true" />
    
    <setting 
        id="trakt_rating_min_progress" 
        type="number" 
        label="Progresso mínimo para perguntar (%)"
        default="70"
        visible="eq(-1,true)" />
    
    <setting 
        id="trakt_show_notifications" 
        type="bool" 
        label="Mostrar notificações de avaliação"
        default="true"
        visible="eq(-2,true)" />
</category>
    
    <category label="Provedores">
        <setting label="Torrent" type="lsep"/> 
        <setting id="provider.starckfilmes.enabled" type="bool" label="StarckFilmes (Torrent)" default="true" />
        <setting id="provider.filmesmaster.enabled" type="bool" label="FilmesMaster (Torrent)" default="false" />
        <setting id="provider.apachetorrent.enabled" type="bool" label="Apache (Torrent)" default="false" />
        <setting id="provider.comandotop.enabled" type="bool" label="ComandoFilmes (Torrent)" default="false" />
        <setting id="provider.mico-leão.enabled" type="bool" label="Mico-Leão (Torrent)" default="false" /> 
        <setting id="provider.torrentio.enabled" type="bool" label="Torrentio (Torrent)" default="true" /> 
        <setting id="provider.brazuca.enabled" type="bool" label="Brazuca (Torrent)" default="false" /> 

        <setting label="Link Direto" type="lsep"/>  
        <setting id="provider.cdflix.enabled" type="bool" label="CDflix (Direto)" default="true" />  
        <setting id="provider.skyflix.enabled" type="bool" label="SkyFlix (Direto)" default="true" />
        <setting id="provider.animezey.enabled" type="bool" label="Animes Totais (Direto)" default="true"/>     
    </category>

    
</settings>