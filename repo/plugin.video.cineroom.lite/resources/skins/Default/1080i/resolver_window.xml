<window type="window" fullscreen="true">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>
        <!-- BACKDROP / FANART -->
        <control type="group">
            <width>1920</width>
            <height>1080</height>

            <!-- Poster -->
            <control type="image">
                <texture background="true">$INFO[Window().Property(info.poster)]</texture>
                <aspectratio align="center" aligny="center">scale</aspectratio>
                <visible>!String.IsEmpty(Window().Property(info.poster))</visible>
            </control>

            <!-- Fanart -->
            <control type="image">
                <texture background="true">$INFO[Window().Property(info.fanart)]</texture>
                <aspectratio align="center" aligny="center">scale</aspectratio>
                <visible>!String.IsEmpty(Window().Property(info.fanart))</visible>
            </control>

            <!-- Dark Overlay -->
            <control type="image">
                <texture background="true">white.png</texture>
                <colordiffuse>CC000000</colordiffuse>
            </control>
        </control>

        <!-- LOGO -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>250</centertop>
            <width>600</width>
            <height>150</height>
            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window().Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window().Property(info.clearlogo))</visible>
            <animation effect="zoom" start="100" end="110" center="auto" time="1200" loop="true" reversible="true" condition="true">PulseLogo</animation>
        </control>

        <!-- TITULO -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>250</centertop>
            <width>1400</width>
            <height>40</height>
            <align>center</align>
            <font>font30</font>
            <textcolor>FFFAFAFA</textcolor>
            <label>$INFO[Window().Property(info.title)]</label>
            <visible>String.IsEmpty(Window().Property(info.clearlogo))</visible>
        </control>

        <!-- SPINNER ANIMADO -->
        <control type="group">
            <centerleft>960</centerleft>
            <centertop>600</centertop>
            <width>150</width>
            <height>150</height>
            <visible>String.IsEqual(Window.Property(enable_busy_spinner),true)</visible>

            <control type="image">
                <width>150</width>
                <height>150</height>
                <texture flipx="true" colordiffuse="66FAFAFA">spinner.png</texture>
                <animation effect="rotate" end="360" center="auto" time="2400" loop="true" reversible="false" condition="true">OuterRotation</animation>
            </control>

            <control type="image">
                <width>100</width>
                <height>100</height>
                <top>25</top>
                <left>25</left>
                <texture flipx="true" colordiffuse="66FAFAFA">spinner.png</texture>
                <animation effect="rotate" end="-360" center="auto" time="2400" loop="true" reversible="false" condition="true">InnerRotation</animation>
            </control>
        </control>

        <!-- STATUS DINÂMICO ABAIXO DO SPINNER -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>780</centertop>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>font24</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window().Property(resolve_status)]</label>
            <visible>String.IsEqual(Window.Property(enable_busy_spinner),true)</visible>
        </control>
    </controls>
</window>
