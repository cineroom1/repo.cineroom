<window type="window" fullscreen="true">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- ==================== FANART ==================== -->
        <control type="image">
                <texture background="true">$INFO[Window().Property(info.fanart)]</texture>
                <aspectratio align="center" aligny="center">scale</aspectratio>
                <visible>!String.IsEmpty(Window().Property(info.fanart))</visible>
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
        </control>

        <!-- ==================== CLEARLOGO ==================== -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>400</centertop>

            <width>700</width>
            <height>180</height>

            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window().Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window().Property(info.clearlogo))</visible>

            <!-- Entrada suave -->
            <animation effect="fade"
                       start="0"
                       end="100"
                       time="700"
                       delay="200">WindowOpen</animation>

            <animation effect="zoom"
                       start="85"
                       end="100"
                       center="960,400"
                       time="700"
                       delay="200"
                       tween="cubic"
                       easing="out">WindowOpen</animation>

            <!-- Pulse natural (respiração suave) -->
            <animation effect="zoom"
                       start="100"
                       end="103"
                       center="960,400"
                       time="1400"
                       tween="sine"
                       easing="inout"
                       loop="true"
                       condition="true">Conditional</animation>

            <animation effect="zoom"
                       start="103"
                       end="100"
                       center="960,400"
                       time="1400"
                       tween="sine"
                       easing="inout"
                       delay="1400"
                       loop="true"
                       condition="true">Conditional</animation>

        </control>

        <!-- ==================== SPINNER ==================== -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>630</centertop>
            <width>70</width>
            <height>70</height>
            <aspectratio>keep</aspectratio>
            <texture>spinner.png</texture>

            <animation effect="fade" start="0" end="100" time="400" delay="600">WindowOpen</animation>

            <animation effect="rotate"
                       start="0"
                       end="360"
                       center="960,630"
                       time="1000"
                       loop="true"
                       condition="true">Conditional</animation>
        </control>

        <!-- ==================== TITLE (fallback) ==================== -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>400</centertop>
            <width>1400</width>
            <height>80</height>

            <align>center</align>
            <font>font40_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>

            <label>$INFO[Window().Property(info.title)]</label>
            <visible>String.IsEmpty(Window().Property(info.clearlogo))</visible>

            <animation effect="fade"
                       start="0"
                       end="100"
                       time="600"
                       delay="200">WindowOpen</animation>
        </control>

    </controls>
</window>