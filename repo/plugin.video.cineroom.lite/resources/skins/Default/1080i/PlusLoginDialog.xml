<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">9101</defaultcontrol>

    <controls>

        <!-- Fundo escurecido -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="DD000000">white.png</texture>
            <animation effect="fade" end="80" time="150">WindowOpen</animation>
            <animation effect="fade" start="80" end="0" time="150">WindowClose</animation>
        </control>

        <!-- Container principal -->
        <control type="group">
            <left>560</left>
            <top>80</top>

            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <animation effect="zoom" start="92" end="100" center="auto" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

            <!-- Borda -->
            <control type="image">
                <left>-2</left>
                <top>-2</top>
                <width>804</width>
                <height>924</height>
                <texture colordiffuse="FFFFCC00" border="30">circle.png</texture>
            </control>

            <!-- Fundo -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>800</width>
                <height>920</height>
                <texture colordiffuse="FF1A1A1A" border="30">circle.png</texture>
            </control>

            <!-- Ícone -->
            <control type="image">
                <left>20</left>
                <top>20</top>
                <width>58</width>
                <height>58</height>
                <aspectratio>keep</aspectratio>
                <texture>special://home/addons/plugin.video.cineroom_lite/icon.png</texture>
            </control>

            <!-- Título -->
            <control type="label">
                <left>320</left>
                <top>30</top>
                <width>680</width>
                <height>36</height>
                <font>font14</font>
                <textcolor>FFFFCC00</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label>[B]Área PLUS[/B]</label>
            </control>

            <!-- Linha -->
            <control type="image">
                <left>20</left>
                <top>88</top>
                <width>760</width>
                <height>2</height>
                <texture colordiffuse="88FFCC00">white.png</texture>
            </control>

            <!-- Moldura dourada sutil -->
            <control type="image">
                <left>272</left>
                <top>110</top>
                <width>256</width>
                <height>256</height>
                <texture colordiffuse="33FFCC00" border="24">circle.png</texture>
                <animation effect="fade" start="0" end="100" time="350" delay="120">WindowOpen</animation>
            </control>

            <!-- Cartão branco -->
            <control type="image">
                <left>272</left>
                <top>110</top>
                <width>256</width>
                <height>256</height>
                <texture colordiffuse="FFFFFFFF" border="22">circle.png</texture>
                <animation effect="fade" start="0" end="100" time="350" delay="140">WindowOpen</animation>
            </control>

            <!-- QR Code -->
            <control type="image">
                <left>272</left>
                <top>110</top>
                <width>256</width>
                <height>256</height>
                <aspectratio>keep</aspectratio>
                <texture>special://home/addons/plugin.video.cineroom.lite/resources/medias/qr_telegram.png</texture>
                <animation effect="fade" start="0" end="100" time="350" delay="160">WindowOpen</animation>
            </control>

            <!-- Mensagem abaixo do QR -->
            <control type="label">
                <left>60</left>
                <top>378</top>
                <width>680</width>
                <height>22</height>
                <font>font12</font>
                <textcolor>FFB0B0B0</textcolor>
                <align>center</align>
                <label>Escaneie o QR do Telegram e tire suas dúvidas.</label>
            </control>

            <control type="label">
                <left>60</left>
                <top>400</top>
                <width>680</width>
                <height>22</height>
                <font>font12</font>
                <textcolor>FFB0B0B0</textcolor>
                <align>center</align>
                <label>Veja como aderir e receber suas credenciais de acesso.</label>
            </control>

            <!-- Linha separadora -->
            <control type="image">
                <left>20</left>
                <top>434</top>
                <width>760</width>
                <height>1</height>
                <texture colordiffuse="44FFFFFF">white.png</texture>
            </control>

            <!-- Usuário label -->
            <control type="label">
                <left>30</left>
                <top>450</top>
                <font>font12</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Usuário</label>
            </control>

            <!-- Fundo usuário -->
            <control type="image">
                <left>30</left>
                <top>482</top>
                <width>740</width>
                <height>52</height>
                <texture colordiffuse="FFFFCC00" border="10">focus.png</texture>
            </control>

            <!-- Edit usuário -->
            <control type="edit" id="9101">
                <left>30</left>
                <top>482</top>
                <width>740</width>
                <height>52</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <hinttext>Digite seu usuário</hinttext>
                <textoffsetx>20</textoffsetx>
                <aligny>center</aligny>
                <texturefocus colordiffuse="00FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="00FFFFFF">white.png</texturenofocus>
                <selectioncolor>00FFFFFF</selectioncolor>
                <ondown>9102</ondown>
                <onup>9104</onup>
            </control>

            <!-- Senha label -->
            <control type="label">
                <left>30</left>
                <top>546</top>
                <font>font12</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Senha</label>
            </control>

            <!-- Fundo senha -->
            <control type="image">
                <left>30</left>
                <top>578</top>
                <width>740</width>
                <height>52</height>
                <texture colordiffuse="FFFFCC00" border="10">focus.png</texture>
            </control>

            <!-- Edit senha -->
            <control type="edit" id="9102">
                <left>30</left>
                <top>578</top>
                <width>740</width>
                <height>52</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <hinttext>Digite sua senha</hinttext>
                <password>true</password>
                <textoffsetx>20</textoffsetx>
                <aligny>center</aligny>
                <texturefocus colordiffuse="00FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="00FFFFFF">white.png</texturenofocus>
                <selectioncolor>00FFFFFF</selectioncolor>
                <onup>9101</onup>
                <ondown>9103</ondown>
            </control>

            <!-- Erro -->
            <control type="label" id="9110">
                <left>30</left>
                <top>636</top>
                <width>740</width>
                <font>font12</font>
                <textcolor>FFFF4444</textcolor>
                <align>center</align>
                <label></label>
                <visible>false</visible>
            </control>

            <!-- Linha separadora -->
            <control type="image">
                <left>20</left>
                <top>662</top>
                <width>760</width>
                <height>1</height>
                <texture colordiffuse="44FFFFFF">white.png</texture>
            </control>

            <!-- Botão Entrar -->
            <control type="button" id="9103">
                <left>65</left>
                <top>680</top>
                <width>300</width>
                <height>60</height>
                <font>font13</font>
                <label>[B]Entrar[/B]</label>
                <texturefocus colordiffuse="FFFFCC00" border="0">common/umbbutton5.png</texturefocus>
                <texturenofocus colordiffuse="FF2A7A2A" border="0">common/umbbutton5.png</texturenofocus>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <onup>9102</onup>
                <onright>9104</onright>
            </control>

            <!-- Botão Cancelar -->
            <control type="button" id="9104">
                <left>414</left>
                <top>680</top>
                <width>300</width>
                <height>60</height>
                <font>font13</font>
                <label>Cancelar</label>
                <texturefocus colordiffuse="FFFFCC00" border="0">common/umbbutton5.png</texturefocus>
                <texturenofocus colordiffuse="FF3A2020" border="0">common/umbbutton5.png</texturenofocus>
                <textcolor>FFAAAAAA</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <onup>9102</onup>
                <onleft>9103</onleft>
            </control>

            <!-- Rodapé -->
            <control type="label">
                <left>30</left>
                <top>764</top>
                <width>740</width>
                <font>font12</font>
                <textcolor>FF555555</textcolor>
                <align>center</align>
                <label>Suporte via Telegram</label>
            </control>

        </control>
    </controls>
</window>