<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>10</defaultcontrol>
    <onback>Close</onback>
    
    <!-- Animações -->
    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="zoom" start="95,95" end="100,100" center="960,540" time="300" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <animation effect="zoom" start="100,100" end="105,105" center="960,540" time="200" tween="cubic" easing="in">WindowClose</animation>

    <controls>
        <!-- FUNDO PRETO SÓLIDO -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
        </control>
        
        <!-- BACKDROP -->
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
            <colordiffuse>60FFFFFF</colordiffuse>
        </control>
        
        <!-- GRADIENTE ESCURO -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="AA000000">white.png</texture>
        </control>

        <!-- POSTER -->
        <control type="image" id="200">
            <top>80</top>
            <left>1250</left>
            <width>650</width>
            <height>950</height>
            <aspectratio aligny="top">stretch</aspectratio>
            <texture diffuse="cineroom_diffuse/poster_w217_h320.png">$INFO[Window.Property(poster)]</texture>
            <effect type="shadow" color="66000000" blur="20" />
            <animation effect="slide" start="200,0" end="0,0" time="400" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="300" delay="100">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="200,0" time="300" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        </control>

        <!-- CONTAINER PRINCIPAL -->
        <control type="group">
            <left>80</left>
            <top>100</top>
            <width>1760</width>
            <height>880</height>
            
            <!-- LOGO/TÍTULO -->
            <control type="group">
                <height>180</height>
                <animation effect="slide" start="0,-50" end="0,0" time="400" tween="cubic" easing="out" delay="100">WindowOpen</animation>
                <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
                
                <control type="image">
                    <width>600</width>
                    <height>150</height>
                    <aspectratio align="left">keep</aspectratio>
                    <texture>$INFO[Window.Property(clearlogo)]</texture>
                    <visible>!IsEmpty(Window.Property(clearlogo))</visible>
                </control>
                
                <control type="label">
                    <width>1200</width>
                    <height>150</height>
                    <font>font60_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(title)]</label>
                    <visible>IsEmpty(Window.Property(clearlogo))</visible>
                    <shadowcolor>80000000</shadowcolor>
                </control>
            </control>

            <!-- METADADOS -->
            <control type="group">
                <top>180</top>
                <height>40</height>
                <animation effect="fade" start="0" end="100" time="400" delay="200">WindowOpen</animation>
                
                <control type="label">
                    <width>1200</width>
                    <height>40</height>
                    <font>font16</font>
                    <textcolor>FFB3B3B3</textcolor>
                    <label>$INFO[Window.Property(year)]  •  $INFO[Window.Property(duration)]</label>
                </control>
            </control>

            <!-- GÊNEROS -->
            <control type="grouplist" id="400">
                <top>230</top>
                <height>50</height>
                <width>1200</width>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                <onup>999</onup>
                <ondown>10</ondown>
                <animation effect="fade" start="0" end="100" time="400" delay="300">WindowOpen</animation>
                
                <control type="button" id="401">
                    <visible>!String.IsEmpty(Window.Property(Genre.1.Label))</visible>
                    <width>auto</width>
                    <height>40</height>
                    <label>$INFO[Window.Property(Genre.1.Label)]</label>
                    <font>font13</font>
                    <align>center</align>
                    <textoffsetx>20</textoffsetx>
                    <texturefocus border="20" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="33FFFFFF">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>999</onup>
                    <ondown>10</ondown>
                </control>
                
                <control type="button" id="402">
                    <visible>!String.IsEmpty(Window.Property(Genre.2.Label))</visible>
                    <width>auto</width>
                    <height>40</height>
                    <label>$INFO[Window.Property(Genre.2.Label)]</label>
                    <font>font13</font>
                    <align>center</align>
                    <textoffsetx>20</textoffsetx>
                    <texturefocus border="20" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="33FFFFFF">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>999</onup>
                    <ondown>10</ondown>
                </control>
                
                <control type="button" id="403">
                    <visible>!String.IsEmpty(Window.Property(Genre.3.Label))</visible>
                    <width>auto</width>
                    <height>40</height>
                    <label>$INFO[Window.Property(Genre.3.Label)]</label>
                    <font>font13</font>
                    <align>center</align>
                    <textoffsetx>20</textoffsetx>
                    <texturefocus border="20" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="33FFFFFF">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>999</onup>
                    <ondown>10</ondown>
                </control>
            </control>

            <!-- BOTÕES PRINCIPAIS -->
            <control type="grouplist" id="10">
                <top>300</top>
                <height>80</height>
                <width>1200</width>
                <orientation>horizontal</orientation>
                <itemgap>15</itemgap>
                <onup>400</onup>
                <ondown>500</ondown>
                <animation effect="slide" start="0,30" end="0,0" time="400" tween="cubic" easing="out" delay="400">WindowOpen</animation>
                <animation effect="fade" start="0" end="100" time="400" delay="400">WindowOpen</animation>
                
                <!-- REPRODUZIR (FILME) -->
                <control type="button" id="301">
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                    <width>280</width>
                    <height>60</height>
                    <label>Reproduzir</label>
                    <font>font16_title</font>
                    <texturefocus border="8" colordiffuse="FFE50914">panel.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="FFFFFFFF">panel.png</texturenofocus>
                    <textcolor>FF000000</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <align>center</align>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>400</onup>
                    <ondown>500</ondown>
                </control>
                
                <!-- VER TEMPORADAS (SÉRIE) -->
                <control type="button" id="321">
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                    <width>280</width>
                    <height>60</height>
                    <label>Ver Temporadas</label>
                    <font>font16_title</font>
                    <texturefocus border="8" colordiffuse="FFE50914">panel.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="FFFFFFFF">panel.png</texturenofocus>
                    <textcolor>FF000000</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <align>center</align>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>400</onup>
                    <ondown>500</ondown>
                </control>
                
                <!-- MINHA LISTA -->
                <control type="button" id="305">
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                    <width>280</width>
                    <height>60</height>
                    <label> +  $INFO[Window.Property(FavoriteLabel)]</label>
                    <font>font14</font>
                    <texturefocus border="8" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="4DFFFFFF">panel.png</texturenofocus>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>400</onup>
                    <ondown>500</ondown>
                </control>
                
                <control type="button" id="322">
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                    <width>280</width>
                    <height>60</height>
                    <label> +  $INFO[Window.Property(FavoriteLabel)]</label>
                    <font>font14</font>
                    <texturefocus border="8" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="4DFFFFFF">panel.png</texturenofocus>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>400</onup>
                    <ondown>500</ondown>
                </control>
                
                <!-- VER COLEÇÃO -->
                <control type="button" id="304">
                    <visible>String.IsEqual(Window.Property(HasCollection),true)</visible>
                    <width>280</width>
                    <height>60</height>
                    <label>Ver Coleção</label>
                    <font>font14</font>
                    <texturefocus border="8" colordiffuse="FFFFFFFF">panel.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="4DFFFFFF">panel.png</texturenofocus>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <animation effect="zoom" start="100" end="105" center="auto" time="150" tween="sine" easing="out">Focus</animation>
                    <animation effect="zoom" start="105" end="100" center="auto" time="150" tween="sine" easing="in">UnFocus</animation>
                    <onup>400</onup>
                    <ondown>500</ondown>
                </control>
            </control>

            <!-- SINOPSE -->
            <control type="button" id="50">
                <top>400</top>
                <width>1100</width>
                <height>320</height>
                <onup condition="String.IsEqual(Window.Property(media_type),movie) + String.IsEqual(Window.Property(HasCollection),true)">315</onup>
                <onup condition="String.IsEqual(Window.Property(media_type),movie) + !String.IsEqual(Window.Property(HasCollection),true)">305</onup>
                <onup condition="String.IsEqual(Window.Property(media_type),tvshow)">322</onup>
                <ondown>999</ondown>
                <texturefocus colordiffuse="FF00AEEF" border="30">circle.png</texturefocus>
                <texturenofocus colordiffuse="FF1F2020" border="30">circle.png</texturenofocus>
                <animation effect="fade" start="0" end="100" time="400" delay="700">WindowOpen</animation>
            </control>

            <control type="textbox">
                <top>425</top>
                <left>30</left>
                <width>1040</width>
                <height>290</height>
                <font>font13</font>
                <align>justify</align>
                <textcolor>FFDDDDDD</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <visible>!Control.HasFocus(50)</visible>
            </control>

            <control type="textbox">
                <top>425</top>
                <left>30</left>
                <width>1040</width>
                <height>290</height>
                <font>font13</font>
                <align>justify</align>
                <textcolor>FFCCCCCC</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <autoscroll>true</autoscroll>
                <visible>Control.HasFocus(50)</visible>
            </control>

            <!-- PROVEDORES (clicáveis com circle.png) -->
            <control type="group">
                <top>725</top>
                <height>130</height>
                <visible>!IsEmpty(Window.Property(Provider.1.Icon))</visible>
                <animation effect="fade" start="0" end="100" time="400" delay="600">WindowOpen</animation>
                
                <control type="label">
                    <width>1200</width>
                    <height>35</height>
                    <font>font13</font>
                    <textcolor>FF909090</textcolor>
                    <label>Disponível em:</label>
                </control>
                
                <control type="grouplist" id="500">
                    <top>40</top>
                    <height>80</height>
                    <width>1200</width>
                    <orientation>horizontal</orientation>
                    <itemgap>15</itemgap>
                    <onup>10</onup>
                    <ondown>999</ondown>
                    
                    <!-- Provider 1 -->
                    <control type="button" id="501">
                        <visible>!IsEmpty(Window.Property(Provider.1.Icon))</visible>
                        <width>90</width>
                        <height>75</height>
                        <texturefocus colordiffuse="33FFFFFF" border="30">circle.png</texturefocus>
                        <texturenofocus colordiffuse="1A1A1A" border="30">circle.png</texturenofocus>
                        <onup>10</onup>
                        <ondown>999</ondown>
                    </control>
                    
                    <!-- Provider 2 -->
                    <control type="button" id="502">
                        <visible>!IsEmpty(Window.Property(Provider.2.Icon))</visible>
                        <width>90</width>
                        <height>75</height>
                        <texturefocus colordiffuse="33FFFFFF" border="30">circle.png</texturefocus>
                        <texturenofocus colordiffuse="1A1A1A" border="30">circle.png</texturenofocus>
                        <onup>10</onup>
                        <ondown>999</ondown>
                    </control>
                    
                    <!-- Provider 3 -->
                    <control type="button" id="503">
                        <visible>!IsEmpty(Window.Property(Provider.3.Icon))</visible>
                        <width>90</width>
                        <height>75</height>
                        <texturefocus colordiffuse="33FFFFFF" border="30">circle.png</texturefocus>
                        <texturenofocus colordiffuse="1A1A1A" border="30">circle.png</texturenofocus>
                        <onup>10</onup>
                        <ondown>999</ondown>
                    </control>
                    
                    <!-- Provider 4 -->
                    <control type="button" id="504">
                        <visible>!IsEmpty(Window.Property(Provider.4.Icon))</visible>
                        <width>90</width>
                        <height>75</height>
                        <texturefocus colordiffuse="33FFFFFF" border="30">circle.png</texturefocus>
                        <texturenofocus colordiffuse="1A1A1A" border="30">circle.png</texturenofocus>
                        <onup>10</onup>
                        <ondown>999</ondown>
                    </control>
                </control>
                
                <!-- Logos dos provedores (sobreposto aos botões) -->
                <control type="image">
                    <left>15</left>
                    <top>50</top>
                    <width>60</width>
                    <height>55</height>
                    <texture>$INFO[Window.Property(Provider.1.Icon)]</texture>
                    <aspectratio>keep</aspectratio>
                    <visible>!IsEmpty(Window.Property(Provider.1.Icon))</visible>
                </control>
                
                <control type="image">
                    <left>120</left>
                    <top>50</top>
                    <width>60</width>
                    <height>55</height>
                    <texture>$INFO[Window.Property(Provider.2.Icon)]</texture>
                    <aspectratio>keep</aspectratio>
                    <visible>!IsEmpty(Window.Property(Provider.2.Icon))</visible>
                </control>
                
                <control type="image">
                    <left>225</left>
                    <top>50</top>
                    <width>60</width>
                    <height>55</height>
                    <texture>$INFO[Window.Property(Provider.3.Icon)]</texture>
                    <aspectratio>keep</aspectratio>
                    <visible>!IsEmpty(Window.Property(Provider.3.Icon))</visible>
                </control>
                
                <control type="image">
                    <left>330</left>
                    <top>50</top>
                    <width>60</width>
                    <height>55</height>
                    <texture>$INFO[Window.Property(Provider.4.Icon)]</texture>
                    <aspectratio>keep</aspectratio>
                    <visible>!IsEmpty(Window.Property(Provider.4.Icon))</visible>
                </control>
            </control>
        </control>

        <!-- BOTÃO FECHAR -->
        <control type="button" id="999">
            <top>30</top>
            <left>1830</left>
            <width>60</width>
            <height>60</height>
            <texturefocus colordiffuse="FFFFFFFF">Button/close.png</texturefocus>
            <texturenofocus colordiffuse="80FFFFFF">Button/close.png</texturenofocus>
            <onclick>Action(close)</onclick>
            <onup>500</onup>
            <ondown>400</ondown>
            <onleft>400</onleft>
            <animation effect="zoom" start="100" end="110" center="auto" time="150">Focus</animation>
            <animation effect="zoom" start="110" end="100" center="auto" time="150">UnFocus</animation>
        </control>

        <!-- DICA INFERIOR -->
        <control type="label">
            <top>1020</top>
            <width>1920</width>
            <height>40</height>
            <font>font11</font>
            <textcolor>66FFFFFF</textcolor>
            <align>center</align>
            <label>Pressione [COLOR FFFFFFFF]VOLTAR[/COLOR] para fechar</label>
            <animation effect="fade" start="0" end="100" time="400" delay="800">WindowOpen</animation>
        </control>
    </controls>
</window>