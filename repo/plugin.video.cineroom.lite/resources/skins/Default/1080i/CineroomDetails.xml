<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>312</defaultcontrol>
    <onback>Close</onback>
    <animation effect="slide" start="0,1080" end="0,0" time="400" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
    <animation effect="slide" start="0,0" end="0,1080" time="300" tween="cubic" easing="in">WindowClose</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>

    <controls>
        <!-- BACKGROUND ESCURO -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF101010">AddonWindow/black.png</texture>
        </control>
        
        <!-- BACKDROP COM FADE -->
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
            <colordiffuse>30FFFFFF</colordiffuse>
            <animation effect="fade" start="0" end="100" time="600" delay="200">WindowOpen</animation>
        </control>
        
        <!-- GRADIENTE OVERLAY -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="AA000000">AddonWindow/white.png</texture>
            <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
        </control>

        <!-- POSTER -->
        <control type="image" id="200">
            <top>80</top>
            <left>1250</left>
            <width>650</width>
            <height>950</height>
            <aspectratio aligny="top">stretch</aspectratio>
            <texture diffuse="cineroom_diffuse/poster_w217_h320.png">$INFO[Window.Property(poster)]</texture>
            <effect type="shadow" color="66000000" blur="20" />
            <animation effect="slide" start="200,0" end="0,0" time="400" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="300" delay="100">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="200,0" time="300" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        </control>

        <!-- CONTEÚDO PRINCIPAL -->
        <control type="group">
            <left>100</left>
            <top>80</top>
            <width>1100</width>

            <!-- TÍTULO/LOGO -->
            <control type="group">
                <height>250</height>
                <left>150</left>
                <top>-50</top>
                <control type="image">
                    <width>800</width>
                    <height>200</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(clearlogo)]</texture>
                    <visible>!IsEmpty(Window.Property(clearlogo))</visible>
                    <animation effect="slide" start="0,-300" end="0,0" time="500" tween="cubic" easing="out">WindowOpen</animation>
                    <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
                    <animation effect="slide" start="0,0" end="0,-300" time="300" tween="cubic" easing="in">WindowClose</animation>
                    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
                </control>
                <control type="label" id="100">
                    <width>1100</width>
                    <height>70</height>
                    <font>font60</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <wrapmultiline>true</wrapmultiline>
                    <label>$INFO[Window.Property(title)]</label>
                    <visible>IsEmpty(Window.Property(clearlogo))</visible>
                    <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
                </control>
            </control>

            <!-- ANO + DURAÇÃO -->
            <control type="label" id="103">
                <top>200</top>
                <width>1100</width>
                <height>30</height>
                <font>font14</font>
                <textcolor>FFCCCCCC</textcolor>
                <align>left</align>
                <label>$INFO[Window.Property(year)] • $INFO[Window.Property(duration)]</label>
                <animation effect="fade" start="0" end="100" time="400" delay="200">WindowOpen</animation>
            </control>

            <!-- GÊNEROS -->
            <control type="grouplist" id="400">
                <top>250</top>
                <height>70</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <onup>999</onup>
                <ondown condition="String.IsEqual(Window.Property(media_type),movie) + String.IsEqual(Window.Property(HasCollection),true)">312</ondown>
                <ondown condition="String.IsEqual(Window.Property(media_type),movie) + !String.IsEqual(Window.Property(HasCollection),true)">302</ondown>
                <ondown condition="String.IsEqual(Window.Property(media_type),tvshow)">321</ondown>
                <animation effect="fade" start="0" end="100" time="400" delay="300">WindowOpen</animation>
                
