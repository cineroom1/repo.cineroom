<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>401</defaultcontrol>
    <onback>Close</onback>
    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF101010">AddonWindow/black.png</texture>
        </control>
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
            <colordiffuse>50FFFFFF</colordiffuse>
        </control>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="88000000">white.png</texture>
            <gradient orientation="vertical" start="00000000" end="FF000000" />
        </control>
        <control type="image" id="200">
            <top>150</top>
            <left>1250</left>
            <width>550</width>
            <height>825</height>
            <aspectratio>scale</aspectratio>
            <texture diffuse="cineroom_diffuse/poster_w217_h320.png">$INFO[Window.Property(poster)]</texture>
            <effect type="shadow" color="66000000" blur="20" />
        </control>

        <control type="group">
            <left>100</left>
            <top>80</top>
            <width>1100</width>

            <control type="group">
                <height>200</height>
                <control type="image">
                    <width>800</width>
                    <height>200</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(clearlogo)]</texture>
                    <visible>!IsEmpty(Window.Property(clearlogo))</visible>
                </control>
                <control type="label" id="100">
                    <width>1100</width>
                    <height>70</height>
                    <font>font60</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <wrapmultiline>true</wrapmultiline>
                    <label>$INFO[Window.Property(title)]</label>
                    <visible>IsEmpty(Window.Property(clearlogo))</visible>
                </control>
            </control>

            <control type="label" id="103">
                <top>200</top>
                <width>1100</width>
                <height>30</height>
                <font>font14</font>
                <textcolor>FFCCCCCC</textcolor>
                <align>left</align>
                <label>$INFO[Window.Property(year)] • $INFO[Window.Property(duration)]</label>
            </control>

            <control type="grouplist" id="400">
                <top>250</top>
                <height>60</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <onup>999</onup>
                <ondown>500</ondown>
                <control type="button" id="401">
                    <visible>!String.IsEmpty(Window.Property(Genre.1.Label))</visible>
                    <width>auto</width>
                    <label>$INFO[Window.Property(Genre.1.Label)]</label>
                    <font>font12</font>
                    <align>center</align>
                    <textoffsetx>15</textoffsetx>
                    <texturenofocus colordiffuse="FF282828" border="15">circle.png</texturenofocus>
                    <texturefocus colordiffuse="FF00FFFF" border="15">circle.png</texturefocus>
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                </control>
                <control type="button" id="402">
                    <visible>!String.IsEmpty(Window.Property(Genre.2.Label))</visible>
                    <width>auto</width>
                    <label>$INFO[Window.Property(Genre.2.Label)]</label>
                    <font>font12</font>
                    <align>center</align>
                    <textoffsetx>15</textoffsetx>
                    <texturenofocus colordiffuse="FF282828" border="15">circle.png</texturenofocus>
                    <texturefocus colordiffuse="FF00FFFF" border="15">circle.png</texturefocus>
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                </control>
                <control type="button" id="403">
                    <visible>!String.IsEmpty(Window.Property(Genre.3.Label))</visible>
                    <width>auto</width>
                    <label>$INFO[Window.Property(Genre.3.Label)]</label>
                    <font>font12</font>
                    <align>center</align>
                    <textoffsetx>15</textoffsetx>
                    <texturenofocus colordiffuse="FF282828" border="15">circle.png</texturenofocus>
                    <texturefocus colordiffuse="FF00FFFF" border="15">circle.png</texturefocus>
                    <textcolor>FFCCCCCC</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                </control>
            </control>

            <control type="group" id="6000">
                <top>340</top> <control type="label">
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>[B]Disponível em[/B]</label>
                </control>
                <control type="grouplist" id="500">
                    <top>35</top>
                    <height>60</height>
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <onup>400</onup>
                    <ondown>300</ondown>
                    <control type="button" id="501">
                        <visible>!String.IsEmpty(Window.Property(Provider.1.Label))</visible>
                        <width>auto</width>
                        <label>$INFO[Window.Property(Provider.1.Label)]</label>
                        <font>font12</font>
                        <align>center</align>
                        <textoffsetx>15</textoffsetx>
                        <texturenofocus colordiffuse="FF282828" border="15">circle.png</texturenofocus>
                        <texturefocus colordiffuse="FF00FFFF" border="15">circle.png</texturefocus>
                        <textcolor>FFCCCCCC</textcolor>
                        <focusedcolor>FF000000</focusedcolor>
                    </control>
                    </control>
            </control>

            <control type="grouplist" id="300">
                <top>475</top> <height>80</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <onup>500</onup>
                <ondown>50</ondown>
                <control type="button" id="301">
                    <width>280</width>
                    <height>70</height>
                    <label>Assistir</label>
                    <font>font14</font>
                    <textcolor>FF1F2020</textcolor>
                    <texturefocus colordiffuse="FF00FFFF" border="35">circle.png</texturefocus>
                    <texturenofocus colordiffuse="FFCCCCCC" border="35">circle.png</texturenofocus>
                    <align>center</align>
                </control>
                <control type="button" id="302">
                    <width>280</width>
                    <height>70</height>
                    <label>Selecionar Fonte</label>
                    <font>font14</font>
                    <textcolor>FF1F2020</textcolor>
                    <texturefocus colordiffuse="FF00FFFF" border="35">circle.png</texturefocus>
                    <texturenofocus colordiffuse="FFCCCCCC" border="35">circle.png</texturenofocus>
                    <align>center</align>
                </control>
                <control type="button" id="303">
                    <width>280</width>
                    <height>70</height>
                    <label>Ver Temporadas</label>
                    <font>font14</font>
                    <textcolor>FF1F2020</textcolor>
                    <texturefocus colordiffuse="FF00FFFF" border="35">circle.png</texturefocus>
                    <texturenofocus colordiffuse="FFCCCCCC" border="35">circle.png</texturenofocus>
                    <align>center</align>
                </control>
                <control type="button" id="304">
                    <width>280</width>
                    <height>70</height>
                    <label>$INFO[Window.Property(FavoriteLabel)]</label>
                    <font>font14</font>
                    <textcolor>FF1F2020</textcolor>
                    <texturefocus colordiffuse="FF00FFFF" border="35">circle.png</texturefocus>
                    <texturenofocus colordiffuse="FFCCCCCC" border="35">circle.png</texturenofocus>
                    <align>center</align>
                </control>
            </control>

            <control type="button" id="50">
                <top>595</top> <width>1100</width>
                <height>320</height>
                <onup>300</onup>
                <ondown>999</ondown>
                <texturefocus colordiffuse="FF282828" border="30">circle.png</texturefocus>
                <texturenofocus colordiffuse="FF1F2020" border="30">circle.png</texturenofocus>
            </control>

            <control type="textbox">
                <top>620</top> <left>30</left>
                <width>1040</width>
                <height>290</height>
                <font>font13</font>
                <align>justify</align>
                <textcolor>FFDDDDDD</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <visible>!Control.HasFocus(50)</visible>
            </control>

            <control type="textbox">
                <top>620</top>  <left>30</left>
                <width>1040</width>
                <height>290</height>
                <font>font13</font>
                <align>justify</align>
                <textcolor>FFCCCCCC</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <autoscroll>true</autoscroll>
                <visible>Control.HasFocus(50)</visible>
            </control>

            <control type="label">
                <top>940</top>
                <width>1100</width>
                <height>30</height>
                <font>font12</font>
                <textcolor>FFAAAAAA</textcolor>
                <align>center</align>
                <label>Pressione VOLTAR para fechar • Desative esta função nas configurações</label>
            </control>
        </control>

        <control type="button" id="999">
            <top>20</top>
            <left>1850</left>
            <width>50</width>
            <height>50</height>
            <texturefocus colordiffuse="FF00FFFF">Button/close.png</texturefocus>
            <texturenofocus colordiffuse="66FFFFFF">Button/close.png</texturenofocus>
            <onclick>Action(close)</onclick>
            <onup>50</onup>
            <ondown>400</ondown>
        </control>
    </controls>
</window>