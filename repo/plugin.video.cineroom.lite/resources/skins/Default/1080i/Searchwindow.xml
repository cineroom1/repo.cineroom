<window type="window" fullscreen="true">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- FANART -->
        <control type="image">
            <texture background="true">$INFO[Window().Property(info.fanart)]</texture>
            <aspectratio align="center" aligny="center">keep</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <visible>!String.IsEmpty(Window().Property(info.fanart))</visible>
            <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
        </control>


        <!-- DARK OVERLAY -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="99000000">AddonWindow/black.png</texture>
            <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
        </control>


        <!-- CLEARLOGO (ESTÁTICO) -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>420</centertop>
            <width>750</width>
            <height>250</height>
            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window().Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window().Property(info.clearlogo))</visible>

            <animation effect="fade" start="0" end="100" time="600" delay="150">WindowOpen</animation>
        </control>


        <!-- TITLE (fallback) -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>420</centertop>
            <width>1400</width>
            <height>80</height>
            <align>center</align>
            <font>font40_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>DD000000</shadowcolor>
            <label>$INFO[Window().Property(info.title)]</label>
            <visible>String.IsEmpty(Window().Property(info.clearlogo))</visible>

            <animation effect="fade" start="0" end="100" time="500" delay="150">WindowOpen</animation>
        </control>


        <!-- STATUS -->
        <control type="label" id="10">
            <centerleft>960</centerleft>
            <centertop>620</centertop>
            <width>1400</width>
            <height>40</height>
            <align>center</align>
            <font>font22</font>
            <textcolor>E6FFFFFF</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.status)]</label>

            <animation effect="fade" start="0" end="100" time="500" delay="200">WindowOpen</animation>
        </control>


        <!-- PROGRESS BAR -->
        <control type="group" id="200">
            <centerleft>960</centerleft>
            <centertop>670</centertop>
            <width>800</width>
            <height>16</height>

            <animation effect="fade" start="0" end="100" time="400" delay="250">WindowOpen</animation>


            <!-- fundo -->
            <control type="image" id="201">
                <left>0</left>
                <top>0</top>
                <width>800</width>
                <height>16</height>
                <texture colordiffuse="55FFFFFF">Profile/progress_bg.png</texture>
            </control>


            <!-- fill -->
            <control type="image" id="202">
                <left>0</left>
                <top>0</top>
                <width>0</width>
                <height>16</height>
                <texture>Progress/progress_fill_red.png</texture>
            </control>

        </control>


        <!-- PERCENT -->
        <control type="label" id="30">
            <centerleft>960</centerleft>
            <centertop>705</centertop>
            <width>1400</width>
            <height>40</height>
            <align>center</align>
            <font>font20</font>
            <textcolor>CCFFFFFF</textcolor>
            <shadowcolor>AA000000</shadowcolor>
            <label>$INFO[Window().Property(search.percent)]%</label>

            <animation effect="fade" start="0" end="100" time="500" delay="300">WindowOpen</animation>
        </control>

    </controls>
</window>