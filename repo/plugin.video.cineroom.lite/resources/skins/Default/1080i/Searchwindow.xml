<window type="window" fullscreen="true">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- Fundo -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0A0F24">AddonWindow/white.png</texture>
        </control>

        <!-- ══════════════════════════════════════════
             FANART (fullscreen, com fade-in suave)
        ══════════════════════════════════════════ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture background="true">$INFO[Window().Property(info.fanart)]</texture>
            <aspectratio align="center" aligny="center">scale</aspectratio>
            <visible>!String.IsEmpty(Window().Property(info.fanart))</visible>
            <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             GRADIENT OVERLAY (escurece topo e base)
        ══════════════════════════════════════════ -->
        <!-- overlay base escura -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">AddonWindow/black.png</texture>
            <animation effect="fade" start="0" end="100" time="500">WindowOpen</animation>
        </control>



        <!-- ══════════════════════════════════════════
             ADDON LOGO (canto superior esquerdo)
        ══════════════════════════════════════════ -->
        <control type="image">
            <left>40</left>
            <top>28</top>
            <width>52</width>
            <height>52</height>
            <texture>icon.png</texture>
            <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             CLEARLOGO (centro, grande)
        ══════════════════════════════════════════ -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>400</centertop>
            <width>900</width>
            <height>280</height>
            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window().Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window().Property(info.clearlogo))</visible>
            <animation effect="fade" start="0" end="100" time="700" delay="150">WindowOpen</animation>
            <animation effect="zoom" start="95" end="100" time="700" delay="150">WindowOpen</animation>
        </control>

        <!-- TITLE (fallback sem clearlogo) -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>390</centertop>
            <width>1600</width>
            <height>100</height>
            <align>center</align>
            <font>font_MainMenu</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>DD000000</shadowcolor>
            <label>$INFO[Window().Property(info.title)]</label>
            <visible>String.IsEmpty(Window().Property(info.clearlogo))</visible>
            <animation effect="fade" start="0" end="100" time="600" delay="150">WindowOpen</animation>
        </control>


        <!-- ══════════════════════════════════════════
             QUALITY COUNTERS  (4K | 1080p | 720p | SD)
        ══════════════════════════════════════════ -->
        <control type="label">
            <centerleft>960</centerleft>
            <top>620</top>
            <width>1400</width>
            <height>36</height>
            <align>center</align>
            <font>font22</font>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.quality_line)]</label>
        </control>


        <!-- ══════════════════════════════════════════
             REMAINING PROVIDERS
        ══════════════════════════════════════════ -->
        <control type="label">
            <centerleft>960</centerleft>
            <top>676</top>
            <width>1400</width>
            <height>30</height>
            <align>center</align>
            <font>font20</font>
            <textcolor>FF6495ED</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.remaining)]</label>
            <visible>!String.IsEmpty(Window().Property(search.remaining))</visible>
            <animation effect="fade" start="0" end="100" time="500" delay="350">WindowOpen</animation>
        </control>

        <control type="label">
            <centerleft>960</centerleft>
            <top>668</top>
            <width>400</width>
            <height>28</height>
            <align>center</align>
            <font>font18</font>
            <textcolor>AAFFFFFF</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.elapsed)]</label>
            <visible>!String.IsEmpty(Window().Property(search.elapsed))</visible>
        </control>

<!-- ==================== SPINNER ==================== -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>750</centertop>
            <width>55</width>
            <height>55</height>
            <aspectratio>keep</aspectratio>
            <texture>spinner.png</texture>

            <animation effect="fade" start="0" end="100" time="400" delay="600">WindowOpen</animation>

            <animation effect="rotate"
                       start="0"
                       end="360"
                       center="960,750"
                       time="1000"
                       loop="true"
                       condition="true">Conditional</animation>
        </control>



    </controls>
</window>