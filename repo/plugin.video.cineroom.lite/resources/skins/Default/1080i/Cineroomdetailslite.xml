<?xml version="1.0" encoding="UTF-8"?>

<window>
    <defaultcontrol always="true">301</defaultcontrol>
    <onback>Close</onback>

    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

    <controls>

        <!-- ══ FUNDO PRETO SÓLIDO ══ -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">AddonWindow/white.png</texture>
        </control>

        <!-- ══ BACKDROP ══ -->
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
            <colordiffuse>55FFFFFF</colordiffuse>
        </control>

        <!-- Gradiente esquerda -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1600</width><height>1080</height>
            <texture>common/gradient_left.png</texture>
        </control>
        <!-- Gradiente baixo -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture>common/gradient_bottom.png</texture>
        </control>

        <!-- ══════════════════════════════════════════
             COLUNA ESQUERDA — POSTER
             Posição: left=60, top=100
             Tamanho: 300x450 (poster 2:3)
        ══════════════════════════════════════════ -->
        <control type="image">
                    <top>80</top>
                    <left>1250</left>
                    <width>650</width>
                    <height>1000</height>
                    <aspectratio>keep</aspectratio>
                    <texture diffuse="cineroom_diffuse/poster-50.png" background="true">$INFO[Window.Property(poster)]</texture>
                </control>

        <!-- ══════════════════════════════════════════
             COLUNA DIREITA — INFO PRINCIPAL
             left=400, top=100, width=1100
        ══════════════════════════════════════════ -->
        <control type="group">
            <left>100</left><top>90</top>
            <width>1460</width><height>570</height>

            <!-- ClearLogo (se disponível) — topo -->
            <control type="image">
                <left>200</left><top>-50</top>
                <width>600</width><height>200</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Window.Property(clearlogo)]</texture>
                <visible>!IsEmpty(Window.Property(clearlogo))</visible>
            </control>

            <!-- Título texto (fallback sem clearlogo) -->
            <control type="label">
                <left>0</left><top>0</top>
                <width>900</width><height>72</height>
                <font>font60_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <shadowcolor>AA000000</shadowcolor>
                <align>left</align><aligny>center</aligny>
                <label>$INFO[Window.Property(title)]</label>
                <visible>IsEmpty(Window.Property(clearlogo))</visible>
            </control>

            <!-- Linha de metadados: Ano · Duração · Rating · Certificação -->
            <control type="group">
                <left>0</left><top>210</top>
                <width>900</width><height>36</height>

                <control type="label">
                    <left>0</left><top>0</top>
                    <width>auto</width><height>36</height>
                    <font>font14</font><textcolor>FFCCCCCC</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>$INFO[Window.Property(year)]</label>
                </control>
                <!-- Separador + duração (apenas filmes) -->
                <control type="label">
                    <left>60</left><top>0</top>
                    <width>auto</width><height>36</height>
                    <font>font14</font><textcolor>FFCCCCCC</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>·  $INFO[Window.Property(duration)]</label>
                    <visible>!IsEmpty(Window.Property(duration))</visible>
                </control>
                <!-- Rating numérico -->
                <control type="label">
                    <left>220</left><top>0</top>
                    <width>auto</width><height>36</height>
                    <font>font14</font><textcolor>FFFFD700</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>★  $INFO[Window.Property(rating)]</label>
                    <visible>!IsEmpty(Window.Property(rating))</visible>
                </control>
                <!-- Certificação -->
                <control type="image">
                    <left>340</left><top>0</top>
                    <width>36</width><height>36</height>
                    <aspectratio>keep</aspectratio>
                    <texture>Ratings/$INFO[Window.Property(certification)].png</texture>
                    <visible>!IsEmpty(Window.Property(certification))</visible>
                </control>
            </control>

            <!-- Gêneros — labels simples (não são botões clicáveis, economiza recursos) -->
            <control type="label">
                <left>0</left><top>255</top>
                <width>900</width><height>28</height>
                <font>font13</font><textcolor>FF888888</textcolor><shadowcolor>88000000</shadowcolor>
                <label>$INFO[Window.Property(Genre.1.Label)] | $INFO[Window.Property(Genre.2.Label)] | $INFO[Window.Property(Genre.3.Label)]</label>
            </control>

            <!-- ══ SINOPSE ══ -->
            <control type="textbox">
                <left>0</left><top>330</top>
                <width>930</width><height>280</height>
                <font>font12</font>
                <textcolor>FFB8B8B8</textcolor>
                <shadowcolor>44000000</shadowcolor>
                <align>justify</align>
                <!-- Sem autoscroll — economiza ciclos de CPU -->
                <label>$INFO[Window.Property(plot)]</label>
            </control>

            <!-- ══ PROVEDORES (logos estáticos via properties) ══
                 Usa images diretas setadas por setProperty em Python.
                 Sem panel/fixedlist — zero overhead de lista.
                 IDs 551–554 correspondem às properties provider_icon_1..4
            -->
            <control type="group">
                <left>0</left><top>750</top>
                <width>600</width><height>80</height>
                <visible>String.IsEqual(Window.Property(HasProviders),true)</visible>

                <control type="label">
                    <left>0</left><top>0</top>
                    <width>200</width><height>24</height>
                    <font>font10</font><textcolor>88FFFFFF</textcolor>
                    <label>Disponível em</label>
                </control>

                <control type="image">
                    <left>0</left><top>33</top>
                    <width>50</width><height>50</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(provider_icon_1)]</texture>
                    <visible>!IsEmpty(Window.Property(provider_icon_1))</visible>
                </control>
                <control type="image">
                    <left>58</left><top>33</top>
                    <width>50</width><height>50</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(provider_icon_2)]</texture>
                    <visible>!IsEmpty(Window.Property(provider_icon_2))</visible>
                </control>
                <control type="image">
                    <left>116</left><top>33</top>
                    <width>50</width><height>50</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(provider_icon_3)]</texture>
                    <visible>!IsEmpty(Window.Property(provider_icon_3))</visible>
                </control>
                <control type="image">
                    <left>174</left><top>33</top>
                    <width>50</width><height>50</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(provider_icon_4)]</texture>
                    <visible>!IsEmpty(Window.Property(provider_icon_4))</visible>
                </control>
            </control>

            <!-- ══ COLUNA DE METADADOS (direita) ══
                 Nota, Gênero, Avaliados, Tipo — estilo da imagem de referência
            -->
            <control type="group">
                <left>500</left><top>515</top>
                <width>520</width><height>200</height>
                <!-- Badge 4K -->
                <control type="image">
                    <left>0</left><top>122</top>
                    <width>100</width><height>50</height>
                    <aspectratio>keep</aspectratio>
                    <texture>badges/4k.png</texture>
                    <visible>String.IsEqual(Window.Property(Is4K),true)</visible>
                </control>
                <!-- Badge Assistido -->
                <control type="image">
                    <left>70</left><top>122</top>
                    <width>32</width><height>32</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFFFFFFF">badges/watched.png</texture>
                    <visible>String.IsEqual(Window.Property(IsWatched),true)</visible>
                </control>
            </control>

        </control>

        <!-- ══════════════════════════════════════════
             BARRA DE BOTÕES DE AÇÃO
             left=60, top=680
             Layout: [Reproduzir (largo)] [♥] [📌] [🎬 Versão]
             IDs mantidos iguais ao CineroomDetails.xml full
             para compatibilidade total com o onClick do Python.
        ══════════════════════════════════════════ -->
        <control type="group">
            <left>100</left><top>730</top>
            <width>1800</width><height>90</height>

            <!-- PLAY / NAVEGAR (301) — botão largo vermelho -->
            <control type="group">
                <left>0</left><top>0</top>
                <width>240</width><height>88</height>

                <control type="button" id="301">
                    <left>0</left><top>4</top>
                    <width>240</width><height>80</height>
                    <label></label>
                    <texturefocus border="0" colordiffuse="FFE50914">common/umbbutton5.png</texturefocus>
                    <texturenofocus border="0" colordiffuse="FF2A2A2A">common/umbbutton5.png</texturenofocus>
                    <onup>999</onup>
                    <ondown>301</ondown>
                    <onleft>302</onleft>
                    <onright>302</onright>
                </control>
                <!-- Ícone play -->
                <control type="image">
                    <left>20</left><top>20</top>
                    <width>48</width><height>48</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFFFFFFF">Button/play.png</texture>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>
                <!-- Ícone lista temporadas -->
                <control type="image">
                    <left>20</left><top>20</top>
                    <width>48</width><height>48</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFFFFFFF">Button/episodes.png</texture>
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                </control>
                <control type="label">
                    <left>85</left><top>20</top>
                    <width>160</width><height>48</height>
                    <font>font16_title</font><textcolor>FFFFFFFF</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <label>Play</label>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>
                <control type="label">
                    <left>67</left><top>20</top>
                    <width>160</width><height>48</height>
                    <font>font16_title</font><textcolor>FFFFFFFF</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <label>Navegar</label>
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                </control>
            </control>

            <!-- FAVORITO (302) -->
            <control type="group">
                <left>256</left><top>0</top>
                <width>170</width><height>88</height>

                <control type="button" id="302">
                    <left>2</left><top>4</top>
                    <width>100</width><height>80</height>
                    <label></label>
                    <texturenofocus border="0" colordiffuse="FF2A2A2A">common/umbbutton5.png</texturenofocus>
                    <texturefocus border="0" colordiffuse="55FFFFFF">common/umbbutton5.png</texturefocus>
                    <onup>999</onup>
                    <ondown>302</ondown>
                    <onleft>301</onleft>
                    <onright>306</onright>
                </control>
                <!-- Ícone: não favoritado -->
                <control type="image">
                    <left>17</left><top>10</top>
                    <width>70</width><height>70</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="99FFFFFF">badges/heart.png</texture>
                    <visible>String.IsEqual(Window.Property(FavoriteLabel),Minha Lista)</visible>
                </control>
                <!-- Ícone: favoritado -->
                <control type="image">
                    <left>17</left><top>10</top>
                    <width>70</width><height>70</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFE50914">badges/heart_full.png</texture>
                    <visible>String.IsEqual(Window.Property(FavoriteLabel),Remover)</visible>
                </control>
            </control>

            <!-- BIBLIOTECA (306) -->
            <control type="group">
                <left>380</left><top>0</top>
                <width>170</width><height>88</height>

                <control type="button" id="306">
                    <left>0</left><top>4</top>
                    <width>100</width><height>80</height>
                    <label></label>
                    <texturenofocus border="0" colordiffuse="FF2A2A2A">common/umbbutton5.png</texturenofocus>
                    <texturefocus border="0" colordiffuse="55FFFFFF">common/umbbutton5.png</texturefocus>
                    <onup>999</onup>
                    <ondown>306</ondown>
                    <onleft>302</onleft>
                    <onright>300</onright>
                </control>
                <control type="image">
                    <left>17</left><top>8</top>
                    <width>70</width><height>70</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="99FFFFFF">badges/bookmark.png</texture>
                    <visible>String.IsEqual(Window.Property(InLibrary),false)</visible>
                </control>
                <control type="image">
                    <left>17</left><top>10</top>
                    <width>70</width><height>70</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF4A90D9">badges/bookmark_true.png</texture>
                    <visible>String.IsEqual(Window.Property(InLibrary),true)</visible>
                </control>
            </control>
        </control>

        <!-- ══ BOTÃO FECHAR (999) ══ -->
        <control type="button" id="999">
            <top>30</top><left>1830</left>
            <width>60</width><height>60</height>
            <texturefocus colordiffuse="FFFFFFFF">Button/close.png</texturefocus>
            <texturenofocus colordiffuse="80FFFFFF">Button/close.png</texturenofocus>
            <onclick>Action(close)</onclick>
            <onup>999</onup>
            <ondown>301</ondown>
            <onleft>999</onleft>
            <onright>999</onright>
        </control>

        <!-- ══ DICA DE RODAPÉ ══ -->
        <control type="label">
            <left>0</left><top>1048</top>
            <width>1920</width><height>20</height>
            <font>font10</font>
            <textcolor>44FFFFFF</textcolor>
            <align>center</align>
            <label>Pressione [COLOR 88FFFFFF]VOLTAR[/COLOR] para fechar</label>
        </control>

    </controls>
</window>