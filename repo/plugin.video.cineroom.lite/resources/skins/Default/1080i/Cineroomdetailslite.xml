<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">301</defaultcontrol>
    <onback>Close</onback>

    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

    <controls>

        <!-- Fundo -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF141414">AddonWindow/white.png</texture>
        </control>

        <!-- Poster (esquerda, vertical) -->
        <control type="image">
            <left>-30</left>
            <top>80</top>
            <width>660</width>
            <height>820</height>
            <aspectratio>keep</aspectratio>
            <texture diffuse="cineroom_diffuse/poster-50.png">$INFO[Window.Property(poster)]</texture>
        </control>

        <!-- Botões de ação (abaixo do poster) -->
        <control type="grouplist">
            <left>35</left>
            <top>930</top>
            <width>600</width>
            <height>110</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>

            <!-- Play / Navegar -->
            <control type="group">
                <width>190</width><height>90</height>

                <control type="button" id="301">
                    <left>0</left><top>5</top>
                    <width>220</width><height>80</height>
                    <label></label>
                    <texturefocus border="0" colordiffuse="FFE50914">common/button_white_solid.png</texturefocus>
                    <texturenofocus border="0" colordiffuse="FF2A2A2A">common/button_white_solid.png</texturenofocus>
                    <onright>302</onright>
                    <animation effect="zoom" start="100" end="103" center="auto" time="120">Focus</animation>
                    <animation effect="zoom" start="103" end="100" center="auto" time="120">UnFocus</animation>
                </control>
                <control type="label">
                    <left>82</left><top>12</top>
                    <width>140</width><height>64</height>
                    <label>Play</label>
                    <font>font16_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>
                <control type="label">
                    <left>50</left><top>12</top>
                    <width>150</width><height>64</height>
                    <label>Navegar</label>
                    <font>font16_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                </control>
            </control>

            <!-- Favoritos -->
            <control type="group">
                <width>90</width><height>110</height>

                <control type="button" id="302">
                    <left>40</left><top>0</top>
                    <width>80</width><height>80</height>
                    <label></label>
                    <texturenofocus border="0" colordiffuse="11FFFFFF">circle.png</texturenofocus>
                    <texturefocus border="0" colordiffuse="44FFFFFF">circle.png</texturefocus>
                    <onright>306</onright>
                    <onleft>301</onleft>
                    <animation effect="zoom" start="100" end="110" center="auto" time="120">Focus</animation>
                    <animation effect="zoom" start="110" end="100" center="auto" time="120">UnFocus</animation>
                </control>
                <control type="image">
                    <left>60</left><top>20</top>
                    <width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="88FFFFFF">badges/heart.png</texture>
                    <visible>String.IsEqual(Window.Property(FavoriteLabel),Minha Lista)</visible>
                </control>
                <control type="image">
                    <left>60</left><top>20</top>
                    <width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFE50914">badges/heart_full.png</texture>
                    <visible>String.IsEqual(Window.Property(FavoriteLabel),Remover)</visible>
                </control>
                <control type="label">
                    <left>25</left><top>84</top>
                    <width>100</width><height>26</height>
                    <label>Favoritos</label>
                    <font>font10</font>
                    <textcolor>88FFFFFF</textcolor>
                    <align>center</align><aligny>center</aligny>
                </control>
            </control>

            <!-- Biblioteca -->
            <control type="group">
                <width>135</width><height>110</height>

                <control type="button" id="306">
                    <left>50</left><top>0</top>
                    <width>80</width><height>80</height>
                    <label></label>
                    <texturenofocus border="0" colordiffuse="11FFFFFF">circle.png</texturenofocus>
                    <texturefocus border="0" colordiffuse="44FFFFFF">circle.png</texturefocus>
                    <onright>307</onright>
                    <onleft>302</onleft>
                    <animation effect="zoom" start="100" end="110" center="auto" time="120">Focus</animation>
                    <animation effect="zoom" start="110" end="100" center="auto" time="120">UnFocus</animation>
                </control>
                <control type="image">
                    <left>70</left><top>20</top>
                    <width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="88FFFFFF">badges/bookmark.png</texture>
                    <visible>String.IsEqual(Window.Property(InLibrary),false)</visible>
                </control>
                <control type="image">
                    <left>70</left><top>20</top>
                    <width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF9B8EC4">badges/bookmark_true.png</texture>
                    <visible>String.IsEqual(Window.Property(InLibrary),true)</visible>
                </control>
                <control type="label">
                    <left>35</left><top>84</top>
                    <width>115</width><height>26</height>
                    <label>Biblioteca</label>
                    <font>font10</font>
                    <textcolor>88FFFFFF</textcolor>
                    <align>center</align><aligny>center</aligny>
                </control>
            </control>

            <!-- Watchlist -->
            <control type="group">
                <width>135</width><height>110</height>

                <control type="button" id="307">
                    <left>20</left><top>0</top>
                    <width>80</width><height>80</height>
                    <label></label>
                    <texturenofocus border="0" colordiffuse="11FFFFFF">circle.png</texturenofocus>
                    <texturefocus border="0" colordiffuse="44FFFFFF">circle.png</texturefocus>
                    <onright>301</onright>
                    <onleft>306</onleft>
                    <animation effect="zoom" start="100" end="110" center="auto" time="120">Focus</animation>
                    <animation effect="zoom" start="110" end="100" center="auto" time="120">UnFocus</animation>
                    </control>
                        <control type="image">
                            <left>27</left><top>10</top>
                            <width>65</width><height>65</height>
                            <aspectratio>keep</aspectratio>
                            <texture colordiffuse="88FFFFFF">badges/watchlist.png</texture>
                            <visible>String.IsEqual(Window.Property(WatchlistLabel),Quero Assistir)</visible>
                        </control>
                        <control type="image">
                            <left>27</left><top>10</top>
                            <width>65</width><height>65</height>
                            <aspectratio>keep</aspectratio>
                            <texture colordiffuse="FF4CAF50">badges/watched.png</texture>
                            <visible>String.IsEqual(Window.Property(WatchlistLabel),Remover Lista)</visible>
                        </control>
                        <control type="label">
                            <left>10</left><top>84</top>
                            <width>120</width><height>26</height>
                            <label>Watchlist</label>
                            <font>font10</font>
                            <textcolor>88FFFFFF</textcolor>
                            <align>center</align><aligny>center</aligny>
                        </control>
                </control>

            <!-- Badge Assistido (só visual) -->
            <control type="group">
                <width>80</width><height>110</height>
                <visible>String.IsEqual(Window.Property(IsWatched),true)</visible>

                <control type="image">
                    <left>20</left><top>20</top>
                    <width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF9B8EC4">badges/watched.png</texture>
                </control>
                <control type="label">
                    <left>0</left><top>64</top>
                    <width>80</width><height>26</height>
                    <label>Assistido</label>
                    <font>font10</font>
                    <textcolor>88FFFFFF</textcolor>
                    <align>center</align><aligny>center</aligny>
                </control>
            </control>

        </control>
        <!-- fim botões -->

        <!-- Logo CineRoom -->
        <control type="image">
            <right>-80</right>
            <top>5</top>
            <width>280</width>
            <height>60</height>
            <align>right</align>
            <aspectratio>keep</aspectratio>
            <texture>logo_cineroom.png</texture>
            <colordiffuse>88FFFFFF</colordiffuse>
        </control>

        <!-- Área principal: título + ficha + plot + elenco + provedores -->
        <control type="group">
            <left>610</left>
            <top>80</top>
            <width>1320</width>
            <height>920</height>

            <!-- Título -->
            <control type="label">
                <left>0</left>
                <top>-10</top>
                <font>font40_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <shadowcolor>AA000000</shadowcolor>
                <align>left</align>
                <aligny>top</aligny>
                <label>$INFO[Window.Property(title)] ($INFO[Window.Property(year)])</label>
            </control>

            <!-- Ficha técnica -->
            <control type="group">
                <left>0</left>
                <top>100</top>
                <width>900</width>
                <height>90</height>

                <!-- NOTA -->
            <control type="group">
                <left>0</left><top>10</top>
                <width>600</width><height>56</height>
                <visible>!IsEmpty(Window.Property(rating))</visible>

                <control type="label">
                    <left>0</left><top>0</top>
                    <width>100</width><height>56</height>
                    <font>font52_title</font>
                    <textcolor>FFC8A028</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <label>$INFO[Window.Property(rating)]</label>
                </control>
                <control type="label">
                    <left>92</left><top>0</top>
                    <width>80</width><height>56</height>
                    <font>font16_title</font>
                    <textcolor>33FFFFFF</textcolor>
                    <align>left</align><aligny>center</aligny>
                    <label>/ 10</label>
                </control>
            </control>

                <!-- FAIXA ETÁRIA -->
                <control type="image">
                    <left>200</left><top>7</top>
                    <width>60</width><height>60</height>
                    <aspectratio>keep</aspectratio>
                    <texture>Ratings/$INFO[Window.Property(certification)].png</texture>
                    <visible>!IsEmpty(Window.Property(certification))</visible>
                </control>

                <!-- DURAÇÃO (só filmes) -->
                <control type="label">
                    <left>320</left><top>0</top>
                    <width>150</width><height>26</height>
                    <font>font10</font>
                    <textcolor>55FFFFFF</textcolor>
                    <align>left</align>
                    <label>DURAÇÃO</label>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>
                <control type="label">
                    <left>320</left><top>30</top>
                    <width>150</width><height>40</height>
                    <font>font16_title</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <label>$INFO[Window.Property(duration)]</label>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>

            </control>
            <!-- fim ficha técnica -->

            <!-- GÊNEROS -->
            <control type="grouplist">
                <left>0</left><top>205</top>
                <width>900</width><height>44</height>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                <visible>!String.IsEmpty(Window.Property(Genre.1.Label))</visible>

                <control type="group">
                    <width>260</width><height>44</height>
                    <visible>!String.IsEqual(Window.Property(Genre.1.Label),-EMPTY-)</visible>
                    <control type="image">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <texture border="22" colordiffuse="22FFFFFF">panel.png</texture>
                    </control>
                    <control type="label">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <font>font12</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <align>center</align><aligny>center</aligny>
                        <label>$INFO[Window.Property(Genre.1.Label)]</label>
                    </control>
                </control>

                <control type="group">
                    <width>260</width><height>44</height>
                    <visible>!String.IsEqual(Window.Property(Genre.2.Label),-EMPTY-)</visible>
                    <control type="image">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <texture border="22" colordiffuse="22FFFFFF">panel.png</texture>
                    </control>
                    <control type="label">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <font>font12</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <align>center</align><aligny>center</aligny>
                        <label>$INFO[Window.Property(Genre.2.Label)]</label>
                    </control>
                </control>

                <control type="group">
                    <width>260</width><height>44</height>
                    <visible>!String.IsEqual(Window.Property(Genre.3.Label),-EMPTY-)</visible>
                    <control type="image">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <texture border="22" colordiffuse="22FFFFFF">panel.png</texture>
                    </control>
                    <control type="label">
                        <left>0</left><top>0</top>
                        <width>260</width><height>44</height>
                        <font>font12</font>
                        <textcolor>FFCCCCCC</textcolor>
                        <align>center</align><aligny>center</aligny>
                        <label>$INFO[Window.Property(Genre.3.Label)]</label>
                    </control>
                </control>
            </control>
            <!-- fim gêneros -->

            <!-- Sinopse -->
            <control type="group">
                <left>0</left>
                <top>420</top>
                <width>1380</width>
                <height>48</height>
                <visible>!IsEmpty(Window.Property(CastNames))</visible>

                <control type="label">
                    <left>0</left><top>50</top>
                    <width>120</width><height>22</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <label>[B]SINOPSE[/B]</label>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>85</top>
                    <width>1250</width>
                    <height>500</height>
                    <font>font12</font>
                    <textcolor>FFB0B0B0</textcolor>
                    <shadowcolor>44000000</shadowcolor>
                    <label>$INFO[Window.Property(plot)]</label>
                    <wrapmultiline>true</wrapmultiline>
                    <maxlines>10</maxlines>
                </control>
            </control>    

            <!-- Elenco -->
            <control type="group">
                <left>0</left>
                <top>275</top>
                <width>1380</width>
                <height>48</height>
                <visible>!IsEmpty(Window.Property(CastNames))</visible>

                <control type="label">
                    <left>0</left><top>0</top>
                    <width>120</width><height>22</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <label>[B]ELENCO[/B]</label>
                </control>
                <control type="label">
                    <left>0</left><top>30</top>
                    <width>1380</width><height>28</height>
                    <font>font12</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <wrapmultiline>true</wrapmultiline>
                    <maxlines>2</maxlines>
                    <label>$INFO[Window.Property(CastNames)]</label>
                </control>
            </control>
            <!-- fim elenco -->

            <!-- Provedores -->
            <control type="group">
                <left>0</left>
                <top>360</top>
                <width>600</width>
                <height>90</height>
                <visible>!IsEmpty(Window.Property(ProviderNames))</visible>

                <control type="label">
                    <left>0</left><top>0</top>
                    <width>200</width><height>22</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <label>[B]DISPONÍVEL EM[/B]</label>
                </control>
                <control type="panel" id="511">
                    <left>0</left><top>35</top>
                    <width>600</width><height>60</height>
                    <orientation>horizontal</orientation>
                <itemlayout width="64" height="60">
                    <control type="image">
                    <left>2</left><top>2</top>
                    <width>56</width><height>56</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                </control>
            </itemlayout>
                <focusedlayout width="64" height="60">
                    <control type="image">
                    <left>2</left><top>2</top>
                    <width>56</width><height>56</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                </focusedlayout>
            </control>
        </control>
            <!-- fim provedores -->

        </control>
        <!-- fim área principal -->

        <!-- Botão fechar invisível -->
        <control type="button" id="999">
            <left>-200</left><top>-200</top>
            <width>10</width><height>10</height>
            <label></label>
            <texturefocus></texturefocus>
            <texturenofocus></texturenofocus>
        </control>

        <!-- Hint de navegação -->
        <control type="label">
            <left>0</left><top>1050</top>
            <width>1920</width><height>28</height>
            <font>font10</font>
            <textcolor>33FFFFFF</textcolor>
            <align>center</align>
            <label>Pressione [COLOR 66FFFFFF]VOLTAR[/COLOR] para fechar</label>
        </control>

    </controls>
</window>y