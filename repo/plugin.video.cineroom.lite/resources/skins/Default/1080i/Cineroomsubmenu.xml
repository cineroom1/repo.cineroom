                <label>$INFO[Window.Property(SubMenuTitle)]</label>
                <font>font13_title</font>
                <textcolor>FF00D4FF</textcolor>
                <align>left</align>
                <animation effect="fade" start="0" end="100" time="300" delay="150">WindowOpen</animation>
            </control>

