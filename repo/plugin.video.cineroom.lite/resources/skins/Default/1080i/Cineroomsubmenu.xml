            <animation effect="slide" start="600,0" end="0,0" time="300" tween="sine" easing="out">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="600,0" time="250" tween="sine" easing="in">WindowClose</animation>

            <!-- BACKGROUND DO PAINEL -->
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <width>600</width>
                <height>1080</height>
                <texture colordiffuse="F00A0E27">white.png</texture>
                <aspectratio>scale</aspectratio>
            </control>

            <!-- LINHA LATERAL ESQUERDA (ACENTO AZUL) -->
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <width>4</width>
                <height>1080</height>
                <texture colordiffuse="FF00D4FF">white.png</texture>
            </control>

