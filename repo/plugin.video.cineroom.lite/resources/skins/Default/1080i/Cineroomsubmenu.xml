        <control type="button" id="299">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texturefocus colordiffuse="AA000000">white.png</texturefocus>
            <texturenofocus colordiffuse="AA000000">white.png</texturenofocus>
            <label></label>
            <onclick>299</onclick>
        </control>

