<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">1300</defaultcontrol>
    <controls>
        <control type="image"><texture>$INFO[Window.Property(info.fanart)]</texture><aspectratio>scale</aspectratio><visible>!String.IsEmpty(Window.Property(info.fanart))</visible></control>
        <control type="image"><texture>panel.png</texture><colordiffuse>A0000000</colordiffuse></control>
        <control type="image"><left>50</left><top>-15</top><width>250</width><height>180</height><aspectratio>keep</aspectratio><texture>logo.png</texture></control>
        
        <control type="button" id="1300">
            <left>450</left><top>40</top><width>250</width><height>50</height>
            <font>font14</font>
            <textcolor>white</textcolor>
            <focusedcolor>white</focusedcolor>
            <align>center</align>
            <texturenofocus border="5" colordiffuse="40FFFFFF">white.png</texturenofocus>
            <texturefocus border="5" colordiffuse="FF0084FF">white.png</texturefocus>
            <label>-</label> <onup>1300</onup>
            <ondown>1000</ondown>
            <onleft>1400</onleft>
            <onright>1400</onright>
        </control>
        
        <control type="button" id="1400">
            <left>720</left><top>40</top><width>250</width><height>50</height>
            <font>font14</font>
            <textcolor>white</textcolor>
            <focusedcolor>white</focusedcolor>
            <align>center</align>
            <texturenofocus border="5" colordiffuse="40FFFFFF">white.png</texturenofocus>
            <texturefocus border="5" colordiffuse="FF0084FF">white.png</texturefocus>
            <label>-</label> <onup>1400</onup>
            <ondown>1000</ondown>
            <onleft>1300</onleft>
            <onright>1300</onright>
        </control>

        <control type="group">
            <right>20</right><top>60</top><width>500</width><height>880</height>
            <control type="image"><height>600</height><width>450</width><align>center</align><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(info.poster)]</texture><visible>!String.IsEmpty(Window.Property(info.poster))</visible></control>
            <control type="textbox"><top>650</top><height>200</height><width>460</width><font>font12</font><textcolor>FFFFFFFF</textcolor><align>justify</align><label>$INFO[Window.Property(info.overview)]</label><visible>!String.IsEmpty(Window.Property(info.overview))</visible></control>
        </control>

        <control type="list" id="1000">
            <left>50</left><top>120</top><width>1300</width><height>860</height>
            <onright>60</onright><pagecontrol>60</pagecontrol><itemgap>-30</itemgap> 
            <onup>1300</onup>

            <itemlayout height="170">
                <control type="group">
                    <posx>10</posx><posy>10</posy>
                    <control type="image"><width>200</width><height>150</height><texture border="30">left-circle.png</texture><colordiffuse>FF222222</colordiffuse></control>
                    <control type="label"><left>0</left><top>45</top><width>200</width><height>40</height><font>font30_title</font><textcolor>grey</textcolor><align>center</align><label>$INFO[ListItem.Property(quality)]</label></control>
                    <control type="label"><left>20</left><top>95</top><width>160</width><height>30</height><font>font12</font><textcolor>grey</textcolor><align>center</align><label>$INFO[ListItem.Property(type)]</label></control>
                    
                    <control type="image"><left>200</left><width>1080</width><height>150</height><texture border="15">circle.png</texture><colordiffuse>FF222222</colordiffuse></control>
                    <control type="label"><left>220</left><top>15</top><width>1040</width><height>30</height><font>font14_title</font><textcolor>white</textcolor><label>$INFO[ListItem.Property(release_title)]</label></control>
                    <control type="label"><left>220</left><top>55</top><width>500</width><height>25</height><font>font12</font><textcolor>grey</textcolor><label>Tamanho: $INFO[ListItem.Property(size)]</label></control>
                    <control type="label"><left>520</left><top>55</top><width>500</width><height>25</height><font>font12</font><textcolor>grey</textcolor><label>Peers: $INFO[ListItem.Property(peers)] | Seeders: $INFO[ListItem.Property(seeders)]</label></control>
                    <control type="label"><left>220</left><top>85</top><width>500</width><height>25</height><font>font12</font><textcolor>grey</textcolor><label>Provedor: $INFO[ListItem.Property(provider)]</label></control>
                    <control type="label"><left>520</left><top>85</top><width>500</width><height>25</height><font>font12</font><textcolor>grey</textcolor><label>Idiomas: $INFO[ListItem.Property(languages)]</label></control>
                </control>
            </itemlayout>

            <focusedlayout height="170">
                <control type="group">
                    <posx>10</posx><posy>10</posy>
                    <control type="image"><width>200</width><height>150</height><texture border="30">left-circle.png</texture><colordiffuse>992A3E5C</colordiffuse></control>
                    <control type="label"><left>0</left><top>45</top><width>200</width><height>40</height><font>font30_title</font><textcolor>white</textcolor><align>center</align><label>$INFO[ListItem.Property(quality)]</label></control>
                    <control type="label"><left>20</left><top>95</top><width>160</width><height>30</height><font>font12</font><textcolor>white</textcolor><align>center</align><label>$INFO[ListItem.Property(type)]</label></control>
                    
                    <control type="image"><left>200</left><width>1080</width><height>150</height><texture border="15">circle.png</texture><colordiffuse>C00084FF</colordiffuse></control>
                    <control type="label"><left>220</left><top>15</top><width>1040</width><height>30</height><font>font14_title</font><textcolor>white</textcolor><scroll>true</scroll><aligny>center</aligny> <label>$INFO[ListItem.Property(release_title)]</label></control>
                    <control type="label"><left>220</left><top>55</top><width>500</width><height>25</height><font>font12</font><textcolor>white</textcolor><label>Tamanho: $INFO[ListItem.Property(size)]</label></control>
                    <control type="label"><left>520</left><top>55</top><width>500</width><height>25</height><font>font12</font><textcolor>white</textcolor><label>Peers: $INFO[ListItem.Property(peers)] | Seeders: $INFO[ListItem.Property(seeders)]</label></control>
                    <control type="label"><left>220</left><top>85</top><width>500</width><height>25</height><font>font12</font><textcolor>white</textcolor><label>Provedor: $INFO[ListItem.Property(provider)]</label></control>
                    <control type="label"><left>520</left><top>85</top><width>500</width><height>25</height><font>font12</font><textcolor>white</textcolor><label>Idiomas: $INFO[ListItem.Property(languages)]</label></control>
                </control>
            </focusedlayout>
        </control>
        
        <control type="scrollbar" id="60">
             <left>1360</left><top>120</top><width>25</width><height>860</height><onleft>1000</onleft>
        </control>
    </controls>
</window>