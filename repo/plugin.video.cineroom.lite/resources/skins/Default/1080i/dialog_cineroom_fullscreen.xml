<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">1300</defaultcontrol>
    <animation effect="slide" start="0,1080" end="0,0" time="400">WindowOpen</animation>
    <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
    <controls>

        <!-- Background sólido -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF000000">AddonWindow/white.png</texture>
        </control>

        <!-- Fanart com fade -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture>$INFO[Window.Property(info.fanart)]</texture>
            <animation effect="fade" start="0" end="25" time="0" tween="sine">WindowOpen</animation>
            <visible>!String.IsEmpty(Window.Property(info.fanart))</visible>
        </control>

        <!-- Panel overlay -->
        <control type="image">
            <left>0</left><top>0</top><width>100%</width><height>100%</height>
            <texture>panel.png</texture>
            <colordiffuse>E0000000</colordiffuse>
        </control>

        <!-- ================================ -->
        <!-- CLEARLOGO CENTRALIZADO NO TOPO -->
        <!-- ================================ -->
        <control type="image" id="200">
            <left>600</left>
            <top>20</top>
            <width>720</width>
            <height>140</height>
            <aspectratio align="center" aligny="center">keep</aspectratio>
            <texture>$INFO[Window.Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window.Property(info.clearlogo))</visible>
        </control>

        <!-- Fallback: Título se não tiver clearlogo -->
        <control type="label">
            <left>0</left>
            <top>60</top>
            <width>1920</width>
            <height>60</height>
            <font>font30</font>
            <textcolor>white</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label>$INFO[Window.Property(info.title)]</label>
            <visible>String.IsEmpty(Window.Property(info.clearlogo))</visible>
        </control>

        <!-- ================================ -->
        <!-- BOTÕES DE FILTRO -->
        <!-- ================================ -->

        <!-- Botão Qualidade -->
        <control type="button" id="1300">
            <left>535</left><top>170</top><width>250</width><height>50</height>
            <font>font14</font><textcolor>white</textcolor><align>center</align>
            <texturenofocus>common/umbbutton5.png</texturenofocus>
            <texturefocus colordiffuse="FF3399FF">common/umbbutton5.png</texturefocus>
            <label>Qualidade</label>
            <ondown>1000</ondown><onleft>1500</onleft><onright>1400</onright>
        </control>

        <!-- Botão Provedor -->
        <control type="button" id="1400">
            <left>805</left><top>170</top><width>250</width><height>50</height>
            <font>font14</font><textcolor>white</textcolor><align>center</align>
            <texturenofocus>common/umbbutton5.png</texturenofocus>
            <texturefocus colordiffuse="FF00CC66">common/umbbutton5.png</texturefocus>
            <label>Provedor</label>
            <ondown>1000</ondown><onleft>1300</onleft><onright>1500</onright>
        </control>

        <!-- Botão Idioma -->
        <control type="button" id="1500">
            <left>1075</left><top>170</top><width>250</width><height>50</height>
            <font>font14</font><textcolor>white</textcolor><align>center</align>
            <texturenofocus>common/umbbutton5.png</texturenofocus>
            <texturefocus colordiffuse="FFCC66FF">common/umbbutton5.png</texturefocus>
            <label>Idioma</label>
            <ondown>1000</ondown><onleft>1400</onleft><onright>1300</onright>
        </control>

        <!-- ================================ -->
        <!-- LISTA FULL WIDTH -->
        <!-- ================================ -->
        <control type="list" id="1000">
            <left>50</left>
            <top>240</top>
            <width>1820</width>
            <height>820</height>

            <onright>60</onright>
            <pagecontrol>60</pagecontrol>
            <itemgap>6</itemgap>
            <onup>1300</onup>

            <!-- ========================= -->
            <!-- ITEM LAYOUT NORMAL -->
            <!-- ========================= -->
            <itemlayout height="150">

                <!-- Fundo -->
                <control type="image">
                    <left>0</left><top>10</top>
                    <width>1820</width><height>140</height>
                    <texture colordiffuse="FF1F2020" border="30">panel.png</texture>
                </control>

                <!-- Ícone de Qualidade -->
                <control type="image">
                    <top>15</top>
                    <left>10</left>
                    <width>230</width>
                    <height>120</height>
                    <aspectratio>keep</aspectratio>
                    <texture>resolution/$INFO[ListItem.Property(quality)].png</texture>
                    <visible>!String.IsEmpty(ListItem.Property(quality))</visible>
                </control>

                <!-- Título -->
                <control type="label">
                    <top>15</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <align>left</align>
                    <aligny>top</aligny>
                    <label>$INFO[ListItem.Property(release_title)]</label>
                </control>

                <!-- Linha de Info Técnica -->
                <control type="label">
                    <top>52</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>25</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Codec: $INFO[ListItem.Property(codec)] | HDR: $INFO[ListItem.Property(hdr)] | Áudio: $INFO[ListItem.Property(audio)] | Fonte: $INFO[ListItem.Property(source)]</label>
                    <visible>!String.IsEmpty(ListItem.Property(codec)) + !String.IsEmpty(ListItem.Property(hdr)) + !String.IsEmpty(ListItem.Property(audio)) + !String.IsEmpty(ListItem.Property(source))</visible>
                </control>

                <!-- Seeders + Size -->
                <control type="label">
                    <top>82</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>20</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Seeds: $INFO[ListItem.Property(seeders)] | Tamanho: $INFO[ListItem.Property(size)]</label>
                </control>

                <!-- Provedor + Idioma -->
                <control type="label">
                    <top>110</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>20</height>
                    <font>font10</font>
                    <textcolor>FFCCCCCC</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>Provedor: [COLOR cyan]$INFO[ListItem.Property(provider)][/COLOR] | Idioma: $INFO[ListItem.Property(languages)]</label>
                </control>

            </itemlayout>

            <!-- ========================= -->
            <!-- FOCUSED LAYOUT -->
            <!-- ========================= -->
            <focusedlayout height="150">

                <!-- Fundo highlight -->
                <control type="image">
                    <left>0</left><top>10</top>
                    <width>1820</width><height>140</height>
                    <texture colordiffuse="FF003366" border="30">panel.png</texture>
                </control>

                <!-- Ícone de Qualidade -->
                <control type="image">
                    <top>15</top>
                    <left>10</left>
                    <width>230</width>
                    <height>120</height>
                    <aspectratio>keep</aspectratio>
                    <texture>resolution/$INFO[ListItem.Property(quality)].png</texture>
                    <visible>!String.IsEmpty(ListItem.Property(quality))</visible>
                </control>

                <!-- Título com scroll -->
                <control type="label">
                    <top>15</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <align>left</align>
                    <aligny>top</aligny>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Property(release_title)]</label>
                </control>

                <!-- Linha de Info Técnica -->
                <control type="label">
                    <top>52</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>25</height>
                    <font>font10</font>
                    <textcolor>white</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <label>Codec: $INFO[ListItem.Property(codec)] | HDR: $INFO[ListItem.Property(hdr)] | Áudio: $INFO[ListItem.Property(audio)] | Fonte: $INFO[ListItem.Property(source)]</label>
                    <visible>!String.IsEmpty(ListItem.Property(codec)) + !String.IsEmpty(ListItem.Property(hdr)) + !String.IsEmpty(ListItem.Property(audio)) + !String.IsEmpty(ListItem.Property(source))</visible>
                </control>

                <!-- Seeders + Size -->
                <control type="label">
                    <top>82</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>20</height>
                    <font>font10</font>
                    <textcolor>white</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <label>Seeds: $INFO[ListItem.Property(seeders)] | Tamanho: $INFO[ListItem.Property(size)]</label>
                </control>

                <!-- Provedor + Idioma -->
                <control type="label">
                    <top>110</top>
                    <left>250</left>
                    <width>1500</width>
                    <height>20</height>
                    <font>font10</font>
                    <textcolor>white</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <label>Provedor: [COLOR cyan]$INFO[ListItem.Property(provider)][/COLOR] | Idioma: $INFO[ListItem.Property(languages)]</label>
                </control>

            </focusedlayout>
        </control>

        <!-- Scrollbar -->
        <control type="scrollbar" id="60">
            <left>1880</left><top>240</top><width>15</width><height>820</height>
            <onleft>1000</onleft>
            <texturesliderbackground colordiffuse="FF302F2F">white.png</texturesliderbackground>
            <texturesliderbar colordiffuse="FF555556">white.png</texturesliderbar>
            <texturesliderbarfocus colordiffuse="FF0084FF">white.png</texturesliderbarfocus>
            <orientation>vertical</orientation>
        </control>

    </controls>
</window>