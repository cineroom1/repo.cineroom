<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">9401</defaultcontrol>
    <onback>CloseDialog</onback>

    <controls>

        <!-- Toast container — canto inferior direito -->
        <control type="group">
            <right>40</right>
            <bottom>80</bottom>
            <width>520</width>
            <height>170</height>

            <animation effect="fade" end="100" time="220">WindowOpen</animation>
            <animation effect="slide" start="60" end="0" tween="back" easingtype="out" time="220">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
            <animation effect="slide" start="0" end="60" time="180">WindowClose</animation>

            <!-- Borda sutil -->
            <control type="image">
                <left>-2</left>
                <top>-2</top>
                <width>524</width>
                <height>174</height>
                <texture colordiffuse="55FFFFFF" border="16">circle.png</texture>
            </control>

            <!-- Fundo escuro semitransparente -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>520</width>
                <height>170</height>
                <texture colordiffuse="EE101820" border="16">circle.png</texture>
            </control>

            <!-- Linha de accent ciano no topo -->
            <control type="image">
                <left>16</left>
                <top>0</top>
                <width>488</width>
                <height>3</height>
                <texture colordiffuse="CC00CCFF">white.png</texture>
            </control>

            <!-- Label do próximo episódio (dinâmico via Python: S02E03 — Título) -->
            <control type="label" id="9410">
                <left>20</left>
                <top>14</top>
                <width>480</width>
                <height>28</height>
                <font>font13</font>
                <textcolor>FF00CCFF</textcolor>
                <align>left</align>
                <aligny>center</aligny>
                <label></label>
                <scroll>true</scroll>
            </control>

            <!-- Subtítulo informativo -->
            <control type="label">
                <left>20</left>
                <top>46</top>
                <width>480</width>
                <height>26</height>
                <font>font12</font>
                <textcolor>FF888888</textcolor>
                <align>left</align>
                <label>Reproduzirá automaticamente ao terminar</label>
            </control>

            <!-- Linha separadora -->
            <control type="image">
                <left>16</left>
                <top>80</top>
                <width>488</width>
                <height>1</height>
                <texture colordiffuse="33FFFFFF">white.png</texture>
            </control>

            <!-- Botão PULAR (centralizado) -->
            <control type="button" id="9401">
                <left>110</left>
                <top>90</top>
                <width>300</width>
                <height>52</height>
                <font>font13</font>
                <label>[B]Pular[/B]</label>
                <texturefocus colordiffuse="FF00AADD">common\umbbutton5.png</texturefocus>
                <texturenofocus colordiffuse="CC006688">common\umbbutton5.png</texturenofocus>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <shadowcolor>AA000000</shadowcolor>
                <align>center</align>
                <aligny>center</aligny>
                <animation effect="zoom" start="100" end="104" time="120">Focus</animation>
                <animation effect="zoom" start="104" end="100" time="120">Unfocus</animation>
            </control>

        </control>
    </controls>
</window>