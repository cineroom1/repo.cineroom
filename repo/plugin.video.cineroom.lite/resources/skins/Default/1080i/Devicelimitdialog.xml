<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">9201</defaultcontrol>
    <onback>9201</onback>

    <animation effect="fade" end="100" time="220">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>

    <controls>

        <!-- Fundo escurecido -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="EE060810">white.png</texture>
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
        </control>

        <!-- Container principal 1200x840 centralizado -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1200</width><height>840</height>

            <animation effect="fade" end="100" time="240">WindowOpen</animation>
            <animation effect="zoom" start="94" end="100" center="auto" time="240">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>

            <!-- Borda cyan sutil -->
            <control type="image">
                <left>-2</left><top>-2</top>
                <width>1204</width><height>844</height>
                <texture colordiffuse="4400CCFF" border="30">circle.png</texture>
            </control>

            <!-- Fundo -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>1200</width><height>840</height>
                <texture colordiffuse="FF0D1117" border="30">circle.png</texture>
            </control>

            <!-- Gradiente superior -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>1200</width><height>120</height>
                <texture colordiffuse="CC0D1E2E" border="30">circle.png</texture>
            </control>

            <!-- Icone -->
            <control type="image">
                <left>30</left><top>20</top>
                <width>60</width><height>60</height>
                <aspectratio>keep</aspectratio>
                <texture>special://home/addons/plugin.video.cineroom.lite/resources/images/icon.png</texture>
            </control>

            <!-- Titulo -->
            <control type="label">
                <left>106</left><top>30</top>
                <width>1040</width><height>42</height>
                <font>font20</font>
                <textcolor>FF00CCFF</textcolor>
                <shadowcolor>CC000000</shadowcolor>
                <aligny>center</aligny>
                <label>[B]Limite de Dispositivos[/B]</label>
            </control>

            <!-- Linha header -->
            <control type="image">
                <left>30</left><top>106</top>
                <width>1140</width><height>1</height>
                <texture colordiffuse="2200CCFF">white.png</texture>
            </control>

            <!-- Mensagem principal -->
            <control type="textbox">
                <left>40</left><top>118</top>
                <width>1120</width><height>90</height>
                <font>font14</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Esta conta ja atingiu o limite de dispositivos autorizados. Nao e possivel registrar um novo dispositivo no momento.</label>
            </control>

            <!-- Bloco aviso reset -->
            <control type="image">
                <left>30</left><top>220</top>
                <width>1140</width><height>136</height>
                <texture colordiffuse="18FFFFFF" border="16">circle.png</texture>
            </control>
            <control type="image">
                <left>30</left><top>220</top>
                <width>4</width><height>136</height>
                <texture colordiffuse="BB00CCFF">white.png</texture>
            </control>
            <control type="textbox">
                <left>50</left><top>228</top>
                <width>1100</width><height>120</height>
                <font>font13</font>
                <textcolor>FFAACCDD</textcolor>
                <label>Resetou o Kodi recentemente? O dispositivo anterior ainda esta registrado no servidor. Entre em contato com o desenvolvedor via Telegram para solicitar a revogacao e liberar o acesso.</label>
            </control>

            <!-- Linha divisoria -->
            <control type="image">
                <left>30</left><top>372</top>
                <width>1140</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">white.png</texture>
            </control>

            <!-- Titulo instrucoes -->
            <control type="label">
                <left>40</left><top>388</top>
                <width>1120</width><height>30</height>
                <font>font13</font>
                <textcolor>FF888888</textcolor>
                <label>Para solicitar a revogacao:</label>
            </control>

            <!-- Passo 1 -->
            <control type="label">
                <left>40</left><top>430</top>
                <width>60</width><height>36</height>
                <font>font13</font>
                <textcolor>FF00CCFF</textcolor>
                <label>[B]1.[/B]</label>
            </control>
            <control type="label">
                <left>90</left><top>430</top>
                <width>1070</width><height>36</height>
                <font>font13</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Abra o Telegram e acesse o suporte do Cineroom</label>
            </control>

            <!-- Passo 2 -->
            <control type="label">
                <left>40</left><top>476</top>
                <width>60</width><height>36</height>
                <font>font13</font>
                <textcolor>FF00CCFF</textcolor>
                <label>[B]2.[/B]</label>
            </control>
            <control type="label">
                <left>90</left><top>476</top>
                <width>1070</width><height>36</height>
                <font>font13</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Informe seu usuario e solicite a revogacao do dispositivo antigo</label>
            </control>

            <!-- Passo 3 -->
            <control type="label">
                <left>40</left><top>522</top>
                <width>60</width><height>36</height>
                <font>font13</font>
                <textcolor>FF00CCFF</textcolor>
                <label>[B]3.[/B]</label>
            </control>
            <control type="label">
                <left>90</left><top>522</top>
                <width>1070</width><height>36</height>
                <font>font13</font>
                <textcolor>FFCCCCCC</textcolor>
                <label>Apos a confirmacao, feche e reabra o addon para fazer login</label>
            </control>

            <!-- Linha rodape -->
            <control type="image">
                <left>30</left><top>600</top>
                <width>1140</width><height>1</height>
                <texture colordiffuse="1AFFFFFF">white.png</texture>
            </control>

            <!-- Aviso tentativas -->
            <control type="label">
                <left>0</left><top>618</top>
                <width>1200</width><height>28</height>
                <align>center</align>
                <font>font12</font>
                <textcolor>FF444444</textcolor>
                <label>Tentativas repetidas serao bloqueadas temporariamente.</label>
            </control>

            <!-- Botao Fechar -->
            <control type="button" id="9201">
                <left>400</left><top>670</top>
                <width>400</width><height>60</height>
                <align>center</align><aligny>center</aligny>
                <font>font14</font>
                <label>[B]Fechar[/B]</label>
                <texturefocus colordiffuse="FF00CCFF" border="14">circle.png</texturefocus>
                <texturenofocus colordiffuse="FF006688" border="14">circle.png</texturenofocus>
                <textcolor>FF000000</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <animation effect="zoom" start="100" end="104" time="120">Focus</animation>
                <animation effect="zoom" start="104" end="100" time="120">Unfocus</animation>
            </control>

        </control>

    </controls>
</window>