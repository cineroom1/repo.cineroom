<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">101</defaultcontrol>
    <coordinates>
        <s>1</s>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    
    <controls>
        <!-- BACKGROUND COM GRADIENTE -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0A0E27">white.png</texture>
            <aspectratio>scale</aspectratio>
        </control>
        
        <!-- LOGO CENTRALIZADO -->
        <control type="image">
            <posx>710</posx>
            <posy>30</posy>
            <top>-30</top>
            <width>500</width>
            <height>200</height>
            <texture>logo.png</texture>
            <aspectratio>keep</aspectratio>
            <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
        </control>
        
        <control type="group">
            <posx>1400</posx>
            <posy>30</posy>
            <width>440</width>
            <height>120</height>
            <animation effect="fade" start="0" end="100" time="400" delay="200">WindowOpen</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>80</width>
                <height>80</height>
                <texture>DefaultUser.png</texture>
                <aspectratio>keep</aspectratio>
                <bordertexture colordiffuse="FF00D4FF">white.png</bordertexture>
                <bordersize>2</bordersize>
            </control>

            <control type="label">
                <left>95</left>
                <top>5</top>
                <width>340</width>
                <height>40</height>
                <label>$INFO[Window.Property(ProfileName)]</label>
                <font>font13</font>
                <textcolor>$INFO[Window.Property(ProfileColor)]</textcolor>
                <align>left</align>
            </control>

            <control type="label">
                <left>95</left>
                <top>40</top>
                <width>340</width>
                <height>30</height>
                <label>$INFO[System.Date] | $INFO[System.Time]</label>
                <font>font10</font>
                <textcolor>BBFFFFFF</textcolor>
                <align>left</align>
            </control>

            <control type="label">
                <visible>!String.IsEmpty(Window.Property(KidsMode))</visible>
                <left>95</left>
                <top>70</top>
                <width>340</width>
                <height>30</height>
                <label>$INFO[Window.Property(KidsMode)]</label>
                <font>font10</font>
                <textcolor>FFFF9800</textcolor>
                <align>left</align>
            </control>
        </control>
        
        <!-- GRID DE BOTÕES 2x4 COM EFEITO GLASS -->
        <control type="grouplist" id="100">
            <posx>240</posx>
            <posy>260</posy>
            <width>1440</width>
            <height>650</height>
            <itemgap>30</itemgap>
            <orientation>vertical</orientation>
            <onup>100</onup>
            <ondown>100</ondown>
            <animation effect="fade" start="0" end="100" time="400" delay="300">WindowOpen</animation>
            
            <!-- LINHA 1: FILMES | SÉRIES | MINHA LISTA | TRAKT -->
            <control type="grouplist" id="110">
                <width>1440</width>
                <height>295</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                
                <!-- BOTÃO FILMES -->
                <control type="button" id="101">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>FILMES</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>105</onup>
                    <ondown>105</ondown>
                    <onleft>104</onleft>
                    <onright>102</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO SÉRIES -->
                <control type="button" id="102">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>SÉRIES</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>106</onup>
                    <ondown>106</ondown>
                    <onleft>101</onleft>
                    <onright>103</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO MINHA LISTA -->
                <control type="button" id="103">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>MINHA LISTA</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>107</onup>
                    <ondown>107</ondown>
                    <onleft>102</onleft>
                    <onright>104</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO TRAKT (OCULTO PARA PERFIS KIDS) -->
                <control type="button" id="104">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>TRAKT</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>108</onup>
                    <ondown>108</ondown>
                    <onleft>103</onleft>
                    <onright>101</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
            </control>
            
            <!-- LINHA 2: PESQUISAR | PERFIL | TOOLS | SAIR -->
            <control type="grouplist" id="120">
                <width>1440</width>
                <height>295</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                
                <!-- BOTÃO PESQUISA -->
                <control type="button" id="105">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>PESQUISAR</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>101</onup>
                    <ondown>101</ondown>
                    <onleft>108</onleft>
                    <onright>106</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO PERFIL -->
                <control type="button" id="106">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF00D4FF</focusedcolor>
                    <label>PERFIL</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="5500D4FF" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>102</onup>
                    <ondown>102</ondown>
                    <onleft>105</onleft>
                    <onright>107</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO TOOLS -->
                <control type="button" id="107">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FFFFA500</focusedcolor>
                    <label>[COLOR orange]TOOLS[/COLOR]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="55FFA500" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>103</onup>
                    <ondown>103</ondown>
                    <onleft>106</onleft>
                    <onright>108</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
                
                <!-- BOTÃO SAIR -->
                <control type="button" id="108">
                    <width>350</width>
                    <height>295</height>
                    <font>font13_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FFFF4444</focusedcolor>
                    <label>[COLOR red]SAIR[/COLOR]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <texturefocus colordiffuse="55FF4444" border="5">white.png</texturefocus>
                    <texturenofocus colordiffuse="331E2749" border="5">white.png</texturenofocus>
                    <onup>104</onup>
                    <ondown>104</ondown>
                    <onleft>107</onleft>
                    <onright>105</onright>
                    <animation effect="zoom" center="auto" start="100" end="107" time="200">Focus</animation>
                    <animation effect="zoom" center="auto" start="107" end="100" time="200">UnFocus</animation>
                </control>
            </control>
        </control>
        
        <!-- VERSÃO (CANTO INFERIOR ESQUERDO) -->
        <control type="label">
            <posx>30</posx>
            <posy>1030</posy>
            <width>400</width>
            <height>40</height>
            <label>Cineroom Lite v$INFO[System.AddonVersion(plugin.video.cineroom.lite)]</label>
            <font>font10</font>
            <textcolor>88FFFFFF</textcolor>
            <animation effect="fade" start="0" end="100" time="400" delay="450">WindowOpen</animation>
        </control>
        
        <!-- HINT DE NAVEGAÇÃO (CANTO INFERIOR DIREITO) -->
        <control type="label">
            <posx>1890</posx>
            <posy>1030</posy>
            <width>500</width>
            <height>40</height>
            <label>ESC para sair | ENTER para selecionar</label>
            <font>font10</font>
            <textcolor>88FFFFFF</textcolor>
            <align>right</align>
            <animation effect="fade" start="0" end="100" time="400" delay="450">WindowOpen</animation>
        </control>
        
        <!-- ANIMAÇÃO DE FECHAMENTO -->
        <animation effect="fade" start="100" end="0" time="250" condition="String.IsEqual(Window.Property(closing),true)">Conditional</animation>
        <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
    </controls>
</window>