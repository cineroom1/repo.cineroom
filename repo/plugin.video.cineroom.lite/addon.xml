<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.cineroom.lite" version="1.4.0" name="Cineroom Lite" provider-name="Gael">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests"/>
    <import addon="script.cineroom.burst" optional="true"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.service" library="service.py" start="startup"/>

  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <description lang="pt_BR">Biblioteca de filmes e séries.</description>
    <disclaimer lang="pt_BR">OBRIGADO PELA PREFERÊNCIA S2</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://cineroom1.github.io</source>
    <email>cineroom.ofc@gmail.com</email>
    <assets>
      <icon>resources/images/icon.png</icon>
      <screenshot>resources/images/screenshot01.jpg</screenshot>
      <screenshot>resources/images/screenshot02.jpg</screenshot>
      <screenshot>resources/images/screenshot03.jpg</screenshot>
    </assets>
  </extension>
</addon>