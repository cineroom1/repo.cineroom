<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.cineroom.lite" version="1.3.3" name="Cineroom [COLOR cyan]Lite[/COLOR]" provider-name="Gael">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests" />
    <import addon="script.module.simplejson" version="3.19.1"/> 
    <import addon="script.module.beautifulsoup4" />
  </requires>

  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.service" library="service.py" start="login" />

  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    
    <description lang="pt_BR">Este é um addon sem fins lucrativos. Somos apenas uma biblioteca de itens</description>
    <disclaimer lang="pt_BR">OBRIGADO PELA PREFERENCIA S2</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://cineroom1.github.io</source>
    <email>cineroom.ofc@gmail.com</email>
    <assets>
      <po>resources/language</po>
      <icon>resources/images/icon.png</icon>
      <fanart>resources/images/fanart.jpg</fanart>
      <screenshot>resources/images/screenshot-1.jpg</screenshot>
      <screenshot>resources/images/screenshot-2.jpg</screenshot>
      <screenshot>resources/images/screenshot-3.jpg</screenshot>
    </assets>
  </extension>
</addon>
<addon id="repository.cineroom" name="Cineroom Repo" version="1.0.0" provider-name="Gael">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Cineroom Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/cineroom1/repo.cineroom/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/cineroom1/repo.cineroom/main/addons.xml.md5</checksum>
      <datadir>https://raw.githubusercontent.com/cineroom1/repo.cineroom/main/repo/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Repositório oficial Cineroom</summary>
    <description>Repositório com os addons oficiais do Cineroom</description>
    <platform>all</platform>
	<assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
